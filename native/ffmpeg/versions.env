#
# The source archives build.sh builds from. Change a version only together
# with its URL and SHA-256, after checking the upstream signature.

# FFmpeg 8.0.3 "Huffman", signed by the FFmpeg release signing key
# FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8.
FFMPEG_VERSION=8.0.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.0.3.tar.xz
FFMPEG_SHA256=6136812ea6d4e68bdba27e33c2a94382711cdf4f8602ffef056ff792bd6f9818

# dav1d 1.5.5, signed by the VideoLAN release signing key
# 65F7 C6B4 206B D057 A7EB 7378 7180 713B E58D 1ADC.
DAV1D_VERSION=1.5.5
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.5/dav1d-1.5.5.tar.xz
DAV1D_SHA256=ca96b1d0ba3f01f55de7231d775892b64994ba061aaeeaaa4f662a390b3abf9e
