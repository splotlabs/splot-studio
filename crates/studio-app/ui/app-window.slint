// The main window: one centred card, a thin workspace shell around the Encode,
// Analyze (analyze.slint) and Compare (compare.slint) views. The shell's toolbar switches the
// workspace and opens Jobs, a popup over both that lists every conversion
// and stream read; Rust owns which workspace is shown and every job row. In Encode, Source, Quality,
// Priority and Convert are on the left; Advanced opens to the right. Values
// come from Rust; every callback is an intent that Rust validates and answers
// by setting properties back. Nothing here touches files, processes or the
// codec. The only state kept here is view state: whether Advanced is open.

import { AboutSlint, Button, ComboBox, Palette, ScrollView, SpinBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { FocusRing, KeyboardFocus } from "focus.slint";
import { Caption, Label, LinkButton, SectionTitle, WorkspaceSwitch } from "controls.slint";
import { IconButton, Playback, PlaybackPanel, StageState } from "stage.slint";
import { AnalyzeView } from "analyze.slint";
import { CompareView } from "compare.slint";
import { ValidationSetup } from "validation-setup.slint";
import { DecodeExport, ExportForm, ExportPurpose, ExportSetup, ExportSourceRow } from "export-setup.slint";

export { DecodeExport, ExportForm, ExportPurpose, ExportSourceRow }
import { AdvancedEditor, AdvancedOptionRow, FieldRow } from "advanced.slint";

export { AdvancedOptionRow, FieldRow }

// Re-exported so Rust can pin the appearance for renderer snapshots, and the
// picture area's state for Rust to set.
export { Palette, Playback, StageState }
export { TimelineBar, TimelineUi } from "timeline.slint";
export { Layers, LayerDetail } from "layers.slint";
export { Blocks, BlockTableRow } from "blocks.slint";
export { StageInspector, StageValue } from "stage-inspector.slint";
export { EntropyTableRow, EntropyView } from "entropy.slint";
export { BlockOutline, BlockOverlay, OverlayRow } from "block-overlay.slint";
export { CoefficientRow, CoefficientView } from "coefficients.slint";
export { BlockMotionView, MotionGlyph, MotionRegion, PredictionFact, PredictorRow } from "block-motion.slint";
export { ReferenceLinkRow, ReferenceSlotRow, References } from "references.slint";
export { Analysis, AnalysisState, ByteCell, ByteLine, ByteRegion, EvidenceRow, Legend, NavRow, NavStep, Property } from "analyze.slint";

// Which workspace the shell shows.
export { CompareSetting, CompareSide, CompareState, Comparison } from "compare.slint";

export enum WorkspaceView { encode, analyze, compare }

// How a status line should read; the text always says the same thing in words.
export enum Tone { neutral, success, warning, error }

// What the engine said about the chosen source.
export enum SourceView { none, probing, ready, unreadable }

// Where the current or last job is. `none` shows the Convert button.
export enum JobView { none, running, cancelling, completed, cancelled, failed, lost, interrupted }

// How the queue is shown: the empty state, the one-file card, or a list.
export enum ViewMode { empty, single, list }

// A row's state, for its icon; `state-text` always says it in words.
export enum RowState { probing, waiting, unreadable, converting, done, failed, cancelled, interrupted }

// One file of the list.
export struct QueueRow {
    name: string,
    // "1080p  •  412 MB", or what is known so far.
    line: string,
    state: RowState,
    state-text: string,
    // "Remove", "Cancel", "Retry", "Show in Folder".
    action: string,
    action-description: string,
    progress-known: bool,
    progress: float,
    // Name, facts and state for screen readers.
    accessible: string,
}

// A one-line notice under the wordmark.
export struct Notice {
    text: string,
    tone: Tone,
}

// One fact the engine read from the source header.
export struct Fact {
    label: string,
    value: string,
}

// One job of the Jobs list. `state` says it
// in words; the tone only repeats it. The bar shows only when the share is
// known (`progress-known`); an operation without progress shows none.
export enum JobAction { clone-settings, reencode, final-pass }

export struct JobRow {
    kind: string,
    name: string,
    state: string,
    tone: Tone,
    detail: string,
    progress-known: bool,
    progress: float,
    can-cancel: bool,
    can-show: bool,
    can-export: bool,
    can-remove: bool,
    can-clone-settings: bool,
    can-reencode: bool,
    can-encode-with-pass: bool,
    // Kind, name, state and detail for screen readers.
    accessible: string,
}

// One verification check of a finished job. `outcome` is the word
// ("Passed", "Failed", "Not run"); colour only repeats it.
export struct CheckRow {
    name: string,
    outcome: string,
    detail: string,
    tone: Tone,
}

global Tones {
    public pure function color(tone: Tone) -> color {
        return tone == Tone.success ? Tokens.success
            : tone == Tone.warning ? Tokens.warning
            : tone == Tone.error ? Tokens.error
            : Tokens.text-disabled;
    }
}

// Static desktop adaptation of the Splot wordmark (docs/assets/hero.svg in
// Splot, PolyForm Noncommercial 1.0.0, same owner): gradient "splot" in the OS
// font, followed by the product word. No font or SVG animation is bundled.
component Wordmark inherits HorizontalLayout {
    in property <length> size: Tokens.type-title * 1rem;
    spacing: 0.3 * root.size;
    accessible-role: text;
    accessible-label: "Splot Studio";

    Text {
        text: "splot";
        color: Tokens.brand;
        font-size: root.size;
        font-weight: Tokens.weight-bold;
        accessible-role: none;
        vertical-alignment: center;
    }

    Text {
        text: "studio";
        color: Tokens.text-secondary;
        font-size: root.size;
        font-weight: Tokens.weight-regular;
        accessible-role: none;
        vertical-alignment: center;
    }
}

component StatusDot inherits Rectangle {
    in property <Tone> tone;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: Tones.color(root.tone);
    accessible-role: none;
}

// The one accent-filled action. Enter or Space activates it.
component PrimaryButton inherits KeyboardFocus {
    in property <string> text;
    in property <string> description;
    callback clicked();

    min-height: Tokens.primary-height;
    min-width: max(120px, label.preferred-width + 2 * Tokens.space-4);
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    key-pressed(event) => {
        if root.enabled && (event.text == Key.Return || event.text == " ") {
            root.clicked();
            return accept;
        }
        reject
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-medium;
    }

    Rectangle {
        border-radius: Tokens.radius-medium;
        background: !root.enabled ? Tokens.track
            : touch.pressed ? Tokens.accent.darker(0.1)
            : touch.has-hover ? Tokens.accent-hover
            : Tokens.accent;
        border-width: root.enabled ? 0px : 1px;
        border-color: Tokens.border;
        animate background { duration: Tokens.motion-short; }

        label := Text {
            text: root.text;
            color: root.enabled ? Tokens.on-accent : Tokens.text-disabled;
            font-size: Tokens.type-body * 1rem;
            font-weight: Tokens.weight-semibold;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// A row of mutually exclusive steps, read as a radio group. Arrow keys,
// Home and End move the selection; `selected` -1 means no step matches.
component Segmented inherits KeyboardFocus {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback chosen(int);

    property <int> count: root.options.length;
    min-height: Tokens.control-height + 4px;
    accessible-role: radio-group;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    key-pressed(event) => {
        if !root.enabled || root.count == 0 {
            return reject;
        }
        if event.text == Key.RightArrow {
            root.keyboard-used();
            root.chosen(root.selected < 0 ? 0 : min(root.count - 1, root.selected + 1));
            return accept;
        }
        if event.text == Key.LeftArrow {
            root.keyboard-used();
            root.chosen(root.selected < 0 ? root.count - 1 : max(0, root.selected - 1));
            return accept;
        }
        if event.text == Key.Home {
            root.keyboard-used();
            root.chosen(0);
            return accept;
        }
        if event.text == Key.End {
            root.keyboard-used();
            root.chosen(root.count - 1);
            return accept;
        }
        reject
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-medium;
    }

    Rectangle {
        border-radius: Tokens.radius-medium;
        background: Tokens.track;
        border-width: 1px;
        border-color: Tokens.border;

        HorizontalLayout {
            padding: 2px;
            spacing: 2px;

            for option[i] in root.options: Rectangle {
                property <bool> on: i == root.selected;
                horizontal-stretch: 1;
                border-radius: Tokens.radius-medium - 2px;
                background: self.on ? Tokens.selected : touch.has-hover && root.enabled ? Tokens.border.transparentize(0.6) : transparent;
                drop-shadow-blur: self.on ? 3px : 0px;
                drop-shadow-offset-y: self.on ? 1px : 0px;
                drop-shadow-color: #00000026;
                accessible-role: radio-button;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: self.on;
                accessible-enabled: root.enabled;
                accessible-item-index: i;
                accessible-item-count: root.count;
                accessible-action-default => {
                    if root.enabled {
                        root.chosen(i);
                    }
                }
                animate background { duration: Tokens.motion-short; }

                // The selected step's accent marker; the raised pill and the
                // bold label say the same without colour.
                if self.on: Rectangle {
                    y: parent.height - 5px;
                    height: 2px;
                    width: 16px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 1px;
                    background: root.enabled ? Tokens.accent : Tokens.text-disabled;
                }

                Text {
                    text: option;
                    color: !root.enabled ? Tokens.text-disabled : parent.on ? Tokens.text : Tokens.text-secondary;
                    font-size: Tokens.type-body * 1rem;
                    font-weight: parent.on ? Tokens.weight-semibold : Tokens.weight-regular;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                touch := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => {
                        root.focus();
                        root.chosen(i);
                    }
                }
            }
        }
    }
}

// Real progress: a filled share when the total is known, otherwise a moving
// segment that never claims a share. With reduced motion the segment stays
// still and the counts next to it carry the information.
component Bar inherits Rectangle {
    in property <bool> known;
    in property <float> fraction;
    in property <string> value-text;

    height: 6px;
    border-radius: 3px;
    background: Tokens.track;
    border-width: 1px;
    border-color: Tokens.border;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: "Conversion progress";
    // A number between the bounds, so it reads as a share; no value while
    // the share is not known. The counts are the description.
    accessible-value: root.known ? round(root.fraction * 100) / 100 : "";
    accessible-description: root.value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;

    if root.known: Rectangle {
        x: 0;
        width: parent.width * max(0, min(1, root.fraction));
        height: parent.height;
        border-radius: 3px;
        background: Tokens.accent;
        animate width { duration: Tokens.motion-medium; }
    }

    if !root.known: Rectangle {
        property <bool> started;
        width: parent.width * 0.3;
        height: parent.height;
        border-radius: 3px;
        background: Tokens.accent;
        x: self.started ? parent.width * 0.7 : 0;
        init => {
            self.started = true;
        }
        animate x {
            duration: 1100ms;
            easing: ease-in-out;
            iteration-count: -1;
            direction: alternate;
        }
    }
}

// The Jobs list: one row per job, newest operations last, each with Show
// and, while it can be stopped, Cancel.
component JobList inherits VerticalLayout {
    in property <[JobRow]> jobs;
    in property <bool> actions-enabled;
    callback show(int);
    callback cancel(int);
    callback export-report(int, bool);
    callback remove(int);
    callback action(int, JobAction);

    spacing: Tokens.space-3;
    accessible-role: list;
    accessible-label: "Jobs";

    for job[i] in root.jobs: VerticalLayout {
        spacing: Tokens.space-1;
        accessible-role: list-item;
        accessible-label: job.accessible;
        accessible-item-index: i;
        accessible-item-count: root.jobs.length;

        HorizontalLayout {
            spacing: Tokens.space-2;

            Text {
                horizontal-stretch: 1;
                text: job.kind + " · " + job.name;
                color: Tokens.text;
                font-size: Tokens.type-body * 1rem;
                font-weight: Tokens.weight-semibold;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                text: job.state;
                color: job.tone == Tone.neutral ? Tokens.text-secondary : Tones.color(job.tone);
                font-size: Tokens.type-caption * 1rem;
                font-weight: Tokens.weight-semibold;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        // The row's label says this already; a plain `Text`, because
        // `accessible-role: none` on a `Caption` leaves an unknown element.
        Text {
            text: job.detail;
            color: Tokens.text-secondary;
            font-size: Tokens.type-caption * 1rem;
            wrap: word-wrap;
            accessible-role: none;
        }

        if job.progress-known: Bar {
            known: true;
            fraction: job.progress;
            value-text: job.detail;
        }

        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-4;

            if job.can-show: LinkButton {
                min-height: 0;
                property <bool> export-file: job.kind == "Export Y4M" || job.kind == "Export raw" || job.kind == "Frame hashes";
                text: job.kind == "Validate" ? "Open in Analyze" : self.export-file ? "Show in Folder" : "Show";
                quiet: true;
                description: job.kind == "Validate" ? "Open validation for " + job.name + " in Analyze"
                    : self.export-file ? "Show the export of " + job.name + " in its folder"
                    : "Show " + job.name + " in its workspace";
                clicked => {
                    root.show(i);
                }
            }

            if job.can-cancel: LinkButton {
                min-height: 0;
                text: "Cancel";
                quiet: true;
                description: "Stop " + job.kind + " · " + job.name;
                clicked => {
                    root.cancel(i);
                }
            }

            if job.can-remove: LinkButton {
                min-height: 0;
                text: "Remove";
                quiet: true;
                description: "Remove this job from the list. Published files stay in their folders.";
                clicked => { root.remove(i); }
            }
        }

        if job.can-export: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-4;

            LinkButton {
                text: "Full report JSON…";
                quiet: true;
                description: "Save the full validation report for " + job.name + " as JSON";
                clicked => { root.export-report(i, true); }
            }

            LinkButton {
                text: "Full report text…";
                quiet: true;
                description: "Save the full validation report for " + job.name + " as text";
                clicked => { root.export-report(i, false); }
            }
        }

        if job.can-clone-settings || job.can-reencode || job.can-encode-with-pass: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-4;

            if job.can-clone-settings: LinkButton {
                text: "Clone settings";
                quiet: true;
                enabled: root.actions-enabled;
                description: "Review the settings recorded for " + job.name;
                clicked => { root.action(i, JobAction.clone-settings); }
            }

            if job.can-reencode: LinkButton {
                text: "Re-encode";
                quiet: true;
                enabled: root.actions-enabled;
                description: "Review a new encode with the settings recorded for " + job.name;
                clicked => { root.action(i, JobAction.reencode); }
            }

            if job.can-encode-with-pass: LinkButton {
                text: "Encode with pass";
                quiet: true;
                enabled: root.actions-enabled;
                description: "Review an encode that uses the first pass for " + job.name;
                clicked => { root.action(i, JobAction.final-pass); }
            }
        }
    }
}

// A label and its value side by side, read as one line by screen readers.
component FactRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Tokens.space-2;
    accessible-role: text;
    accessible-label: root.label + ": " + root.value;

    Text {
        width: 84px;
        text: root.label;
        color: Tokens.text-secondary;
        font-size: Tokens.type-caption * 1rem;
        accessible-role: none;
    }

    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Tokens.text;
        font-size: Tokens.type-caption * 1rem;
        wrap: word-wrap;
        accessible-role: none;
    }
}


// A row's state as a small drawn icon. Never alone: the row says the same
// in words next to it.
component StateIcon inherits Rectangle {
    in property <RowState> state;
    property <color> ink: state == RowState.done ? Tokens.success
        : state == RowState.failed || state == RowState.unreadable ? Tokens.error
        : state == RowState.interrupted ? Tokens.warning
        : state == RowState.converting ? Tokens.accent
        : Tokens.text-secondary;
    property <bool> filled: state == RowState.done || state == RowState.failed || state == RowState.interrupted;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background: self.filled ? self.ink : transparent;
    border-width: self.filled ? 0px : 1.5px;
    border-color: state == RowState.probing ? Tokens.text-disabled : self.ink;
    accessible-role: none;

    if root.state == RowState.converting: Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.ink;
    }

    if root.state == RowState.done: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 4.5 8.3 L 7 10.8 L 11.6 5.6";
        stroke: Tokens.on-accent;
        stroke-width: 1.8px;
        fill: transparent;
    }

    if root.state == RowState.failed || root.state == RowState.unreadable: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5.4 5.4 L 10.6 10.6 M 10.6 5.4 L 5.4 10.6";
        stroke: root.state == RowState.failed ? Tokens.on-accent : root.ink;
        stroke-width: 1.7px;
        fill: transparent;
    }

    if root.state == RowState.interrupted: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 4.4 L 8 9 M 8 11.2 L 8 11.9";
        stroke: Tokens.on-accent;
        stroke-width: 1.8px;
        fill: transparent;
    }

    if root.state == RowState.cancelled: Path {
        width: 16px;
        height: 16px;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 5 8 L 11 8";
        stroke: root.ink;
        stroke-width: 1.6px;
        fill: transparent;
    }
}

// One row of the file list: icon, name, facts and state in words, and the
// one quiet action that fits the state. Selecting it shows its details
// under Advanced.
component FileRow inherits Rectangle {
    in property <QueueRow> file;
    // The source's poster frame, or an empty image until it arrives.
    in property <image> thumb;
    in property <bool> selected;
    // The list has keyboard focus and this is the selected row.
    in property <bool> ring;
    in property <bool> last;
    in property <int> index;
    in property <int> count;
    in property <bool> actions-enabled;
    callback select();
    callback act();

    background: root.selected ? Tokens.row-selected : touch.has-hover ? Tokens.row-hover : transparent;
    animate background { duration: Tokens.motion-short; }
    accessible-role: list-item;
    accessible-label: root.file.accessible;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => {
        root.select();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.select();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-3;

        // The poster frame, letterboxed, with the state icon on its corner.
        Rectangle {
            width: 64px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: Tokens.radius-small;
            background: Tokens.stage;
            accessible-role: none;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.thumb;
                image-fit: contain;
                accessible-role: none;
            }

            // Inside the row: the thumbnail is centred in 48px.
            Rectangle {
                x: parent.width - 15px;
                y: parent.height - 15px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.background == transparent ? Tokens.track : root.background;

                StateIcon {
                    state: root.file.state;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;

            Text {
                text: root.file.name;
                color: Tokens.text;
                font-size: Tokens.type-body * 1rem;
                font-weight: Tokens.weight-semibold;
                overflow: elide;
                accessible-role: none;
            }

            HorizontalLayout {
                spacing: Tokens.space-2;

                if root.file.line != "": Text {
                    horizontal-stretch: 0;
                    text: root.file.line + "  •";
                    color: Tokens.text-secondary;
                    font-size: Tokens.type-caption * 1rem;
                    accessible-role: none;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.file.state-text;
                    color: root.file.state == RowState.failed || root.file.state == RowState.unreadable ? Tokens.error
                        : root.file.state == RowState.interrupted ? Tokens.warning
                        : root.file.state == RowState.done ? Tokens.success
                        : Tokens.text-secondary;
                    font-size: Tokens.type-caption * 1rem;
                    font-weight: root.file.state == RowState.failed || root.file.state == RowState.unreadable || root.file.state == RowState.interrupted ? Tokens.weight-semibold : Tokens.weight-regular;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }

        if root.file.action != "": LinkButton {
            text: root.file.action;
            quiet: true;
            highlighted: root.selected;
            description: root.file.action-description + " (" + root.file.name + ")";
            enabled: root.actions-enabled;
            // The list is one Tab stop; Enter acts on its selected row.
            focus-on-tab-navigation: false;
            clicked => {
                root.act();
            }
        }
    }

    // A thin progress line along the bottom of the converting row.
    if root.file.state == RowState.converting: Rectangle {
        x: Tokens.space-3;
        y: parent.height - 4px;
        width: parent.width - 2 * Tokens.space-3;
        height: 2px;
        border-radius: 1px;
        background: Tokens.border;
        clip: true;

        if root.file.progress-known: Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.file.progress));
            height: parent.height;
            background: Tokens.accent;
            animate width { duration: Tokens.motion-medium; }
        }

        if !root.file.progress-known: Rectangle {
            property <bool> started;
            width: parent.width * 0.3;
            height: parent.height;
            background: Tokens.accent;
            x: self.started ? parent.width * 0.7 : 0;
            init => {
                self.started = true;
            }
            animate x {
                duration: 1100ms;
                easing: ease-in-out;
                iteration-count: -1;
                direction: alternate;
            }
        }
    }

    if !root.last && root.file.state != RowState.converting: Rectangle {
        x: Tokens.space-3 + 64px + Tokens.space-3;
        y: parent.height - 1px;
        width: parent.width - self.x;
        height: 1px;
        background: Tokens.border;
    }

    FocusRing {
        shown: root.ring;
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        radius: Tokens.radius-small;
    }
}

// The file list: one Tab stop. Up and Down (Home, End) choose a row,
// Enter or Space performs its action, Delete removes a file that has not
// run. At most `visible-rows` are shown; the rest scroll inside the list.
component FileList inherits KeyboardFocus {
    in property <[QueueRow]> rows;
    // Row thumbnails by index; missing ones show the empty frame.
    in property <[image]> thumbs;
    in property <int> selected;
    in property <bool> actions-enabled;
    in property <int> visible-rows: 5;
    callback row-selected(int);
    callback row-action(int);
    callback remove-requested(int);

    property <length> row-height: 48px;
    property <int> count: root.rows.length;
    height: min(root.count, root.visible-rows) * root.row-height;
    accessible-role: list;
    accessible-label: "Files";
    accessible-description: "Up and Down choose a file. Enter: " + (root.selected >= 0 && root.selected < root.count ? root.rows[root.selected].action : "") + ". Delete removes a file that has not converted.";

    function reveal(i: int) {
        if i * root.row-height < -scroll.content-y {
            scroll.content-y = -i * root.row-height;
        } else if (i + 1) * root.row-height > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -((i + 1) * root.row-height - scroll.visible-height);
        }
    }

    function choose(i: int) {
        root.keyboard-used();
        root.row-selected(i);
        root.reveal(i);
    }

    changed selected => {
        if root.selected >= 0 {
            root.reveal(root.selected);
        }
    }

    key-pressed(event) => {
        if root.count == 0 {
            return reject;
        }
        if event.text == Key.DownArrow {
            root.choose(root.selected < 0 ? 0 : min(root.count - 1, root.selected + 1));
            return accept;
        }
        if event.text == Key.UpArrow {
            root.choose(root.selected < 0 ? 0 : max(0, root.selected - 1));
            return accept;
        }
        if event.text == Key.Home {
            root.choose(0);
            return accept;
        }
        if event.text == Key.End {
            root.choose(root.count - 1);
            return accept;
        }
        if root.selected >= 0 && (event.text == Key.Return || event.text == " ") {
            root.keyboard-used();
            if root.actions-enabled {
                root.row-action(root.selected);
            }
            return accept;
        }
        if root.selected >= 0 && (event.text == Key.Delete || event.text == Key.Backspace) {
            root.keyboard-used();
            if root.actions-enabled {
                root.remove-requested(root.selected);
            }
            return accept;
        }
        reject
    }

    scroll := ScrollView {
        width: root.width;
        height: root.height;
        content-width: self.visible-width;
        content-height: root.count * root.row-height;

        for row[i] in root.rows: FileRow {
            x: 0;
            y: i * root.row-height;
            width: scroll.visible-width;
            height: root.row-height;
            file: row;
            thumb: root.thumbs[i];
            index: i;
            count: root.count;
            last: i == root.count - 1;
            selected: i == root.selected;
            ring: root.ring && i == root.selected;
            actions-enabled: root.actions-enabled;
            select => {
                root.focus();
                root.row-selected(i);
            }
            act => {
                root.row-action(i);
            }
        }
    }
}

export component AppWindow inherits Window {
    // Identity
    in property <string> app-version;

    // The workspace shell: Rust says which workspace is shown, names it and
    // lists the workspaces that can be chosen. Encode is shown by default so
    // a window that Rust has not rendered yet still lays out.
    in property <WorkspaceView> workspace: WorkspaceView.encode;
    in property <string> workspace-title;
    in property <[string]> workspace-labels;
    in property <int> workspace-index;
    // The shown file has a converted result Analyze can open.
    in property <bool> can-analyze-result;
    // The shown file has a converted result that Compare can pair with its source.
    in property <bool> can-compare-result;
    // The Jobs entry's label ("Jobs", "Jobs · 2") and what it says in words.
    in property <string> jobs-label: "Jobs";
    in property <string> jobs-description;
    in property <[JobRow]> jobs;
    in property <bool> job-can-generate-pass;
    in property <bool> job-actions-enabled;
    in property <string> job-related-title;
    in property <string> job-related-detail;
    in property <bool> job-related-ready;
    in property <bool> job-related-failed;
    in property <string> report-dialog-error;
    in property <bool> validation-active;
    in property <string> validation-job-notice;

    // Temporary options for the next Validate Files action.
    out property <bool> validation-open;
    in-out property <bool> validation-strict;
    in property <bool> validation-busy;
    in property <string> validation-context;
    in property <string> validation-notice;

    // Source. Paths are display strings; Rust keeps the real paths.
    in property <SourceView> source-view;
    in property <string> source-name;
    in property <string> source-path;
    // "720p • 12.4 MB", or what is known so far.
    in property <string> source-line;
    in property <[Fact]> source-facts;
    in property <[string]> source-disclosures;
    // Facts are shown (also the last ones while the same file is read again).
    in property <bool> has-source-facts;
    // Why the source cannot be converted, and how serious that reads.
    in property <string> source-problem;
    in property <Tone> source-problem-tone;
    // "Video only — 2 audio tracks … will not be included.", or empty.
    in property <string> omission-summary;
    // The empty state's caption.
    in property <string> empty-caption;

    // How the queue is shown, its rows and which one is selected. In the
    // list, the source properties above describe the selected row.
    in property <ViewMode> view-mode;
    in property <[QueueRow]> rows;
    in property <int> selected-row: -1;
    // "4 files".
    in property <string> list-title;
    // Files can be added now (no question is open).
    in property <bool> can-add: true;
    // The one-file card's link replaces the file (Change…) or, while it
    // converts, adds another (Add…).
    in property <bool> card-replaces: true;
    // Calm one-line notices: a restored list, a journal problem, saving.
    in property <[Notice]> notices;

    // The Video track choice, only when there is more than one.
    in property <bool> has-track-picker;
    in property <[string]> track-labels;
    in-out property <int> track-index;
    in property <string> track-note;

    // The video-only confirmation. Rust shows and closes it from the state.
    in property <string> sheet-body;
    // One line per file when several files are asked about.
    in property <[string]> sheet-items;
    // Platform button order: Windows puts the confirming button first.
    in property <bool> confirm-first;
    out property <bool> sheet-open;
    out property <bool> export-open;

    // Simple controls: views of the same settings as the raw fields.
    in property <[string]> quality-labels;
    in property <int> quality-index;
    in property <bool> rate-overridden;
    in property <[string]> priority-labels;
    in property <int> priority-index;
    in property <string> priority-caption;

    // Destination
    in property <bool> has-destination;
    in property <string> destination-line;
    in property <string> destination-path;
    in property <string> destination-help;
    in property <string> destination-warning;

    // Raw encoder settings, ranges and labels from studio-domain.
    in property <[string]> output-labels;
    in-out property <int> output-index;
    in property <int> preset-min;
    in property <int> preset-max;
    in-out property <int> preset;
    in property <int> crf-min;
    in property <int> crf-max;
    in-out property <int> crf;

    // The settings shown are a file's own (it is converting or converted)
    // and cannot be changed.
    in property <bool> locked;
    in property <bool> can-encode;
    in property <string> encode-status;
    // Neutral for a next step; warning or error when something needs fixing.
    in property <Tone> encode-status-tone;
    // "Convert", "Convert 3 Files" or "Continue", when anything can start.
    in property <string> primary-text: "Convert";
    in property <bool> show-primary: true;
    // "2 of 5" while a run converts several files.
    in property <string> run-position;
    // "4 converted, 1 failed" once files have finished in the list.
    in property <string> summary-text;
    in property <bool> can-clear-finished;
    // Above the settings when they show a file's own settings, read-only.
    in property <string> settings-note;
    // The selected file's destination and video track can be changed.
    in property <bool> destination-editable;
    // The selected file's result, under Advanced in the list.
    in property <string> detail-headline;
    in property <Tone> detail-tone;
    in property <string> detail-text;
    in property <[CheckRow]> detail-checks;

    // The current or last job.
    in property <JobView> job-view;
    in property <string> job-headline;
    in property <Tone> job-tone;
    in property <string> job-detail;
    in property <bool> progress-known;
    in property <float> progress-fraction;
    in property <string> progress-text;
    // Counters under the bar, or that no frame has arrived yet.
    in property <string> progress-line;
    in property <string> elapsed-text;
    in property <[CheckRow]> job-checks;
    in property <string> reveal-error;

    // Who built the engine, and the FFmpeg it reads ordinary files with.
    in property <string> engine-identity: "Not known yet.";
    in property <string> media-tool-line;

    // View state. In-out so renderer snapshots can open it.
    in-out property <bool> advanced-open;
    in property <[AdvancedOptionRow]> advanced-options;
    in property <[FieldRow]> advanced-fields;
    in property <string> advanced-selected;
    in property <string> advanced-label;
    in property <string> advanced-help;
    in property <string> advanced-effective;
    in property <string> advanced-screen;
    in property <string> advanced-origin;
    in property <string> advanced-error;
    in property <string> advanced-status;
    in property <string> advanced-preset-preview;
    in property <bool> advanced-imported-preview;
    in property <bool> advanced-preset-files-ready;
    in property <bool> advanced-preset-file-error;
    in property <string> advanced-preset-file-status;
    in property <bool> advanced-can-undo;
    in property <bool> advanced-can-redo;
    in property <bool> advanced-can-apply-preset;
    in property <bool> advanced-custom;
    property <string> advanced-query;
    property <bool> advanced-modified-only;
    property <bool> advanced-expert-enabled;
    property <int> advanced-focus-request;
    out property <string> advanced-focus-field;
    property <string> advanced-draft-option;
    property <string> advanced-draft-field;
    property <string> advanced-draft-text;
    property <int> advanced-draft-reset;
    in-out property <int> advanced-preset-candidate: root.preset;

    callback advanced-open-changed(bool);
    callback advanced-search(string);
    callback advanced-modified(bool);
    callback advanced-expert(bool);
    callback advanced-select(string);
    callback advanced-edit(string, string);
    callback advanced-reset(string);
    callback advanced-undo();
    callback advanced-redo();
    callback advanced-preview-preset(int);
    callback advanced-apply-preset();
    callback advanced-save-preset();
    callback advanced-import-preset();
    changed advanced-open => {
        if !root.advanced-open {
            root.flush-advanced-draft();
            root.advanced-preset-candidate = root.preset;
        }
        root.advanced-open-changed(root.advanced-open);
    }
    changed preset => { root.advanced-preset-candidate = root.preset; }

    public function reset-advanced-draft() {
        root.advanced-draft-field = "";
        root.advanced-draft-reset += 1;
    }

    public function flush-advanced-draft() {
        if root.advanced-draft-field != "" && root.advanced-draft-option == root.advanced-selected {
            root.advanced-edit(root.advanced-draft-field, root.advanced-draft-text);
            root.advanced-draft-field = "";
        }
    }

    public function focus-advanced-error(field: string) {
        root.advanced-focus-field = field;
        root.advanced-focus-request += 1;
    }

    // Row thumbnails, by row index.
    in property <[image]> row-thumbs;
    // What preview pictures are: under Advanced.
    in property <string> preview-note;
    // The picture area and a row thumbnail in physical pixels: what Rust asks
    // the engine for. They change with the scale factor only.
    out property <int> stage-px-width: round((root.workspace == WorkspaceView.analyze ? analyze-view.full-width : root.main-width) / 1phx);
    out property <int> stage-px-height: round((root.workspace == WorkspaceView.analyze ? analyze-view.playback-height : root.main-width * 9 / 16) / 1phx);
    out property <int> thumb-px-width: round(64px / 1phx);
    out property <int> thumb-px-height: round(36px / 1phx);

    callback open-requested();
    callback analyze-open-requested();
    callback analyze-result-requested();
    callback compare-result-requested();
    callback workspace-chosen(int);
    callback job-show(int);
    callback job-cancel(int);
    callback job-export(int, bool);
    callback job-remove(int);
    callback stop-validation-batch();
    callback validate-files-requested();
    callback validation-cancel();
    callback validation-choose-files();
    callback validation-pick-context();
    callback validation-clear-context();
    callback job-action(int, JobAction);
    callback job-generate-pass();
    callback job-related-approve();
    callback job-related-decline();
    callback change-requested();
    callback row-selected(int);
    callback row-action(int);
    callback remove-requested(int);
    callback clear-finished();
    callback quit-requested();
    callback quality-selected(int);
    callback priority-selected(int);
    callback output-selected(int);
    callback track-selected(int);
    callback preset-edited(int);
    callback crf-edited(int);
    callback choose-destination-requested();
    callback encode-requested();
    callback cancel-requested();
    callback reveal-requested();
    callback reset-requested();
    callback omissions-confirmed();
    callback omissions-declined();
    callback stage-geometry-changed();
    changed stage-px-width => {
        root.stage-geometry-changed();
    }
    changed stage-px-height => {
        root.stage-geometry-changed();
    }

    // Also used by the renderer-snapshot example to capture the dialog.
    public function show-about() {
        about.show();
    }

    // Also used by the renderer snapshots and UI tests.
    public function show-jobs() {
        jobs-popup.show();
    }

    public function show-export-setup() {
        root.export-open = true;
        export-setup.show();
    }

    public function close-export-setup() {
        root.export-open = false;
        export-setup.close();
    }

    public function show-validation-setup() {
        root.validation-open = true;
        validation-setup.show();
    }

    public function close-validation-setup() {
        root.validation-open = false;
        validation-setup.close();
    }

    public function show-sheet() {
        root.sheet-open = true;
        sheet.show();
    }

    public function close-sheet() {
        root.sheet-open = false;
        sheet.close();
    }

    property <keys> open-keys: @keys(Control + O);
    property <keys> analyze-keys: @keys(Control + Shift + O);
    property <bool> has-source: root.view-mode != ViewMode.empty;
    property <bool> job-active: root.job-view == JobView.running || root.job-view == JobView.cancelling;
    property <length> main-width: root.show-advanced && !root.compact-advanced
        ? min(416px, root.advanced-window-width - 540px) : 416px;
    property <bool> show-advanced: root.advanced-open && root.workspace == WorkspaceView.encode;
    property <length> advanced-min-width: min(640px, root.max-window-width);
    property <length> measured-window-width;
    property <length> advanced-window-width: clamp(root.measured-window-width, root.advanced-min-width, root.max-window-width);
    out property <bool> compact-advanced: root.show-advanced && root.advanced-window-width < 900px;
    property <length> scroll-gutter: Tokens.space-6;
    property <length> advanced-card-width: root.advanced-window-width - root.scroll-gutter;
    property <length> advanced-content-width: root.advanced-card-width - 2 * root.card-padding;
    property <length> advanced-width: root.compact-advanced ? root.advanced-content-width
        : root.advanced-content-width - root.main-width - 2 * root.card-padding - 1px;
    property <length> card-padding: Tokens.space-6;
    property <length> form-label-width: 64px;
    property <bool> show-settings: !(root.view-mode == ViewMode.single && root.job-view == JobView.completed);

    title: root.view-mode == ViewMode.list ? root.list-title + " — Splot Studio"
        : root.has-source ? root.source-name + " — Splot Studio" : "Splot Studio";
    background: Tokens.raised;
    // Simple and Analyze fit their content. Advanced can resize horizontally
    // between its compact and split layouts. In-window menu bars add to the
    // fitted height. Copy that offset outside the layout bindings.
    //
    // The window is never taller than `max-window-height`, so it fits a
    // 1366x768 display under a task bar and a title bar. Content taller than
    // that (several files, long messages, large text) scrolls inside the
    // card; Slint scrolls a control that receives focus into view.
    in property <length> max-window-width: 960px;
    in property <length> max-window-height: 680px;
    property <length> visible-content-height: min(content.preferred-height, max(Tokens.space-8 * 4, root.max-window-height - root.fit-offset));
    property <length> fit-offset;
    out property <length> fitted-height: frame.absolute-position.y + min(content.preferred-height, max(Tokens.space-8 * 4, root.max-window-height - frame.absolute-position.y));
    out property <length> fitted-width: root.show-advanced ? root.advanced-window-width
        : min(content.preferred-width, root.max-window-width);
    property <length> fit-height;
    // Rust re-asserts the fitted size: a compositor may answer an earlier
    // request after a newer one and leave the window at the old size.
    callback fit-changed();
    changed fitted-height => {
        self.fit-height = self.fitted-height;
        self.fit-offset = frame.absolute-position.y;
        root.fit-changed();
    }
    changed fitted-width => {
        root.fit-changed();
    }
    changed width => {
        root.measured-window-width = root.width;
    }
    init => {
        self.measured-window-width = self.width;
        self.fit-height = self.fitted-height;
        self.fit-offset = frame.absolute-position.y;
    }
    min-width: root.show-advanced ? root.advanced-min-width : root.fitted-width;
    max-width: root.show-advanced ? root.max-window-width : root.fitted-width;
    min-height: self.fit-height > 0 ? self.fit-height : content.preferred-height;
    max-height: self.fit-height > 0 ? self.fit-height : content.preferred-height;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Open to Convert…";
                shortcut: root.open-keys;
                enabled: root.can-add && !root.sheet-open && !root.validation-open && !root.export-open;
                activated => {
                    root.open-requested();
                }
            }
            MenuItem {
                title: "Open to Analyze…";
                shortcut: root.analyze-keys;
                enabled: !root.sheet-open && !root.validation-open && !root.export-open;
                activated => {
                    root.analyze-open-requested();
                }
            }
            MenuItem {
                title: "Validate Files…";
                enabled: !root.sheet-open && !root.validation-open && !root.export-open && !root.validation-active;
                activated => { root.validate-files-requested(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Quit";
                role: MenuItemRole.quit;
                shortcut: @keys(Control + Q);
                activated => {
                    root.quit-requested();
                }
            }
        }

        Menu {
            title: "View";
            for label[i] in root.workspace-labels: MenuItem {
                title: label;
                checkable: true;
                checked: i == root.workspace-index;
                enabled: !root.sheet-open && !root.validation-open && !root.export-open;
                activated => {
                    root.workspace-chosen(i);
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem {
                title: "About Splot Studio";
                role: MenuItemRole.about;
                activated => {
                    root.show-about();
                }
            }
        }
    }

    frame := VerticalLayout {
        min-width: root.show-advanced ? root.advanced-min-width : root.fitted-width;
        max-width: root.show-advanced ? root.max-window-width : root.fitted-width;
        min-height: root.visible-content-height;
        max-height: root.visible-content-height;

        card-scroll := ScrollView {
            content-width: root.show-advanced ? root.advanced-card-width : content.preferred-width;
            content-height: content.preferred-height;
            horizontal-scrollbar-policy: root.show-advanced ? always-off : as-needed;

                content := VerticalLayout {
                    width: root.show-advanced ? root.advanced-card-width : self.preferred-width;
                    height: self.preferred-height;
                    padding-left: root.card-padding;
                    padding-right: root.card-padding;
                    // The toolbar sits in the card's top padding: with it, Encode
                    // starts about where it did without it, so a file list at the
                    // height cap still shows its progress row without scrolling.
                    padding-top: Tokens.space-1;
                    padding-bottom: root.card-padding - Tokens.space-1;
                    spacing: Tokens.space-1;

                    // The shell's toolbar: the workspace switch and the shared Jobs
                    // entry, which opens the Jobs popup over either workspace.
                    // Caption-sized: it takes no control height from the card.
                    HorizontalLayout {
                        spacing: Tokens.space-3;

                        WorkspaceSwitch {
                            options: root.workspace-labels;
                            selected: root.workspace-index;
                            chosen(i) => {
                                root.workspace-chosen(i);
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        LinkButton {
                            min-height: 0;
                            text: root.jobs-label;
                            quiet: true;
                            description: root.jobs-description;
                            enabled: !root.sheet-open;
                            clicked => {
                                root.show-jobs();
                            }
                        }
                    }

                    // All workspaces stay alive and only the shown one is
                    // visible, so a switch keeps each one's scroll positions and
                    // view state. A hidden one takes no room, receives no input
                    // or focus and is not in the accessibility tree.
                    workspaces := Rectangle {
                        property <bool> analyze: root.workspace == WorkspaceView.analyze;
                        property <bool> compare: root.workspace == WorkspaceView.compare;
                        property <length> shown-width: self.analyze ? analyze-view.preferred-width
                            : self.compare ? compare-view.preferred-width : encode-view.width;
                        property <length> shown-height: self.analyze ? analyze-view.preferred-height
                            : self.compare ? compare-view.preferred-height : encode-view.preferred-height;
                        min-width: self.shown-width;
                        preferred-width: self.shown-width;
                        max-width: self.shown-width;
                        min-height: self.shown-height;
                        preferred-height: self.shown-height;
                        max-height: self.shown-height;

                        analyze-view := AnalyzeView {
                            x: 0;
                            y: 0;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            visible: parent.analyze;
                            open-shortcut: root.analyze-keys.to-string();
                            timeline-active: !root.minimized;
                            copy(text) => {
                                root.copy-text(text);
                            }
                            reveal-bytes => {
                                card-scroll.content-y = min(0px, card-scroll.height - card-scroll.content-height);
                            }
                        }

                        compare-view := CompareView {
                            x: 0;
                            y: 0;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            visible: parent.compare;
                            copy(text) => {
                                root.copy-text(text);
                            }
                        }

                    encode-view := HorizontalLayout {
                        x: 0;
                        y: 0;
                        width: root.show-advanced ? root.advanced-content-width : self.preferred-width;
                        height: self.preferred-height;
                        visible: !parent.analyze && !parent.compare;
                        alignment: start;
                        accessible-role: main;
                        accessible-label: root.workspace-title;

                        // The compact Advanced panel replaces Simple. The wide panel sits beside it.
                        if !root.compact-advanced: VerticalLayout {
                            width: root.main-width;
                            spacing: Tokens.space-4;
                            alignment: start;

                            // The brand greets an empty window; once a file is open
                            // the picture leads and the title bar names the app.
                            if !root.has-source: HorizontalLayout {
                                alignment: start;

                                Wordmark { }
                            }

                            if root.notices.length > 0: VerticalLayout {
                                spacing: Tokens.space-1;

                                for notice in root.notices: Text {
                                    text: notice.text;
                                    color: notice.tone == Tone.neutral ? Tokens.text-secondary : Tones.color(notice.tone);
                                    font-size: Tokens.type-caption * 1rem;
                                    font-weight: notice.tone == Tone.neutral ? Tokens.weight-regular : Tokens.weight-semibold;
                                    wrap: word-wrap;
                                    accessible-live-region: polite;
                                }
                            }

                            // The picture area, on top of the card once a file is open.
                            if root.has-source && Playback.state != StageState.none: PlaybackPanel {
                                picture-height: root.main-width * 9 / 16;
                            }

                            // Source zone: an intentional empty state or the file card.
                            if !root.has-source: Rectangle {
                                height: 176px;
                                border-radius: Tokens.radius-medium + 2px;
                                background: Tokens.track;
                                border-width: 1px;
                                border-color: zone.has-hover && root.can-add ? Tokens.accent : Tokens.border-strong;
                                animate border-color { duration: Tokens.motion-short; }

                                zone := TouchArea {
                                    enabled: root.can-add;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.open-requested();
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Tokens.space-2;
                                    padding: Tokens.space-6;

                                    Text {
                                        text: "Open a video to begin";
                                        color: Tokens.text;
                                        font-size: Tokens.type-title * 1rem;
                                        font-weight: Tokens.weight-semibold;
                                        horizontal-alignment: center;
                                    }

                                    Caption {
                                        text: root.empty-caption;
                                        horizontal-alignment: center;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        padding-top: Tokens.space-1;

                                        open-button := Button {
                                            text: "Open…";
                                            enabled: root.can-add;
                                            accessible-description: "Choose a video file (" + root.open-keys.to-string() + ")";
                                            clicked => {
                                                root.open-requested();
                                            }
                                        }
                                    }
                                }
                            }

                            if root.view-mode == ViewMode.list: VerticalLayout {
                                spacing: Tokens.space-2;

                                Rectangle {
                                    border-radius: Tokens.radius-medium + 2px;
                                    background: Tokens.track;
                                    border-width: 1px;
                                    border-color: Tokens.border;
                                    clip: true;

                                    VerticalLayout {
                                        HorizontalLayout {
                                            padding-left: Tokens.space-3;
                                            padding-right: Tokens.space-2;
                                            padding-top: Tokens.space-1;
                                            padding-bottom: Tokens.space-1;
                                            spacing: Tokens.space-3;

                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.list-title;
                                                color: Tokens.text-secondary;
                                                font-size: Tokens.type-caption * 1rem;
                                                font-weight: Tokens.weight-semibold;
                                                vertical-alignment: center;
                                                accessible-role: none;
                                            }

                                            LinkButton {
                                                text: "Add…";
                                                enabled: root.can-add;
                                                description: "Add videos to the list (" + root.open-keys.to-string() + ")";
                                                clicked => {
                                                    root.open-requested();
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 1px;
                                            background: Tokens.border;
                                        }

                                        FileList {
                                            rows: root.rows;
                                            thumbs: root.row-thumbs;
                                            // The picture above takes the room of two rows.
                                            visible-rows: 3;
                                            selected: root.selected-row;
                                            actions-enabled: !root.sheet-open;
                                            row-selected(i) => {
                                                root.row-selected(i);
                                            }
                                            row-action(i) => {
                                                root.row-action(i);
                                            }
                                            remove-requested(i) => {
                                                root.remove-requested(i);
                                            }
                                        }
                                    }
                                }

                                if root.omission-summary != "" && root.source-view != SourceView.unreadable: Caption {
                                    text: root.omission-summary;
                                    color: Tokens.text;
                                }
                            }

                            if root.view-mode == ViewMode.single: VerticalLayout {
                                    spacing: Tokens.space-2;

                                // The file under its picture: name, facts, Change….
                                VerticalLayout {
                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        HorizontalLayout {
                                            spacing: Tokens.space-3;

                                            HorizontalLayout {
                                                horizontal-stretch: 1;
                                                spacing: Tokens.space-2;
                                                accessible-role: text;
                                                accessible-label: "Source: " + root.source-name + (root.source-line != "" ? ", " + root.source-line : "") + ". Full path: " + root.source-path;

                                                Text {
                                                    horizontal-stretch: 1;
                                                    max-width: self.preferred-width;
                                                    min-width: 48px;
                                                    text: root.source-name;
                                                    color: Tokens.text;
                                                    font-size: Tokens.type-body * 1rem;
                                                    font-weight: Tokens.weight-semibold;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    accessible-role: none;
                                                }

                                                Text {
                                                    horizontal-stretch: 0;
                                                    min-width: self.preferred-width;
                                                    text: root.source-line != "" ? "•  " + root.source-line : "";
                                                    color: Tokens.text-secondary;
                                                    font-size: Tokens.type-body * 1rem;
                                                    vertical-alignment: center;
                                                    accessible-role: none;
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            LinkButton {
                                                text: root.card-replaces ? "Change…" : "Add…";
                                                enabled: root.can-add;
                                                description: root.card-replaces ? "Choose another video" : "Add videos to convert after this one (" + root.open-keys.to-string() + ")";
                                                clicked => {
                                                    if root.card-replaces {
                                                        root.change-requested();
                                                    } else {
                                                        root.open-requested();
                                                    }
                                                }
                                            }
                                        }

                                        if root.source-view == SourceView.probing: Caption {
                                            text: "Reading the file header…";
                                        }

                                        if root.source-view == SourceView.unreadable: Text {
                                            text: root.source-problem;
                                            color: Tones.color(root.source-problem-tone);
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: word-wrap;
                                            accessible-label: "Cannot be converted: " + root.source-problem;
                                        }
                                    }
                                }

                                // Always visible, in words: what a video-only output leaves out.
                                if root.omission-summary != "" && root.source-view != SourceView.unreadable: Caption {
                                    text: root.omission-summary;
                                    color: Tokens.text;
                                }
                            }

                            if root.settings-note != "": Caption {
                                text: root.settings-note;
                            }

                            // Quality and Priority, labels beside their controls as in
                            // a native form, so the card stays short under the picture.
                            // A converted single file has no use for them until
                            // another is chosen; Convert Another brings them back.
                            if root.show-settings: HorizontalLayout {
                                spacing: Tokens.space-3;

                                Label {
                                    width: root.form-label-width;
                                    height: Tokens.control-height + 4px;
                                    text: "Quality";
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                VerticalLayout {
                                    spacing: Tokens.space-1;

                                    Segmented {
                                        options: root.quality-labels;
                                        selected: root.quality-index;
                                        enabled: !root.locked;
                                        label: root.rate-overridden ? "Quality: custom rate control" : root.quality-index < 0 ? "Quality: custom, rate factor " + root.crf : "Quality";
                                        chosen(i) => {
                                            root.quality-selected(i);
                                        }
                                    }

                                    if root.quality-index < 0: Caption {
                                        text: root.rate-overridden ? "Custom rate control (set in Advanced)" : "Custom · rate factor " + root.crf + " (set in Advanced)";
                                        wrap: no-wrap;
                                    }

                                    if root.quality-index >= 0: HorizontalLayout {
                                        Caption {
                                            text: "Smaller file";
                                            horizontal-stretch: 1;
                                            wrap: no-wrap;
                                        }

                                        Caption {
                                            text: "Closer to the source";
                                            horizontal-alignment: right;
                                            wrap: no-wrap;
                                        }
                                    }
                                }
                            }

                            if root.show-settings: HorizontalLayout {
                                spacing: Tokens.space-3;

                                Label {
                                    width: root.form-label-width;
                                    height: Tokens.control-height + 4px;
                                    text: "Priority";
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                VerticalLayout {
                                    spacing: Tokens.space-1;

                                    Segmented {
                                        options: root.priority-labels;
                                        selected: root.priority-index;
                                        enabled: !root.locked;
                                        label: root.priority-index < 0 ? "Priority: custom, speed preset " + root.preset : "Priority";
                                        accessible-description: root.priority-caption;
                                        chosen(i) => {
                                            root.priority-selected(i);
                                        }
                                    }

                                    Caption {
                                        text: root.priority-index < 0 ? "Custom · speed preset " + root.preset + ". " + root.priority-caption : root.priority-caption;
                                    }
                                }
                            }

                            // Action area: Convert, then progress, then the result.
                            VerticalLayout {
                                spacing: Tokens.space-2;

                                if root.job-view == JobView.cancelled || root.job-view == JobView.failed || root.job-view == JobView.lost || root.job-view == JobView.interrupted: Rectangle {
                                    border-radius: Tokens.radius-medium;
                                    background: Tokens.track;
                                    border-width: 1px;
                                    border-color: root.job-view == JobView.cancelled ? Tokens.border : root.job-view == JobView.interrupted ? Tokens.warning : Tokens.error;

                                    VerticalLayout {
                                        padding: Tokens.space-3;
                                        spacing: Tokens.space-1;

                                        HorizontalLayout {
                                            spacing: Tokens.space-2;

                                            StatusDot {
                                                tone: root.job-tone;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.job-headline;
                                                color: Tokens.text;
                                                font-size: Tokens.type-body * 1rem;
                                                font-weight: Tokens.weight-semibold;
                                                overflow: elide;
                                                accessible-live-region: polite;
                                            }
                                        }

                                        Text {
                                            text: root.job-detail;
                                            color: Tokens.text;
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if !root.job-active && root.job-view != JobView.completed: VerticalLayout {
                                    spacing: Tokens.space-2;

                                    if root.summary-text != "": HorizontalLayout {
                                        spacing: Tokens.space-3;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.summary-text;
                                            color: Tokens.text;
                                            font-size: Tokens.type-body * 1rem;
                                            font-weight: Tokens.weight-semibold;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            accessible-live-region: polite;
                                        }

                                        if root.can-clear-finished: LinkButton {
                                            text: "Clear Finished";
                                            enabled: !root.sheet-open;
                                            description: "Remove the converted files from the list. The files themselves stay.";
                                            clicked => {
                                                root.clear-finished();
                                            }
                                        }
                                    }

                                    if root.destination-line != "": Caption {
                                        text: root.destination-line;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }

                                    if root.show-primary: PrimaryButton {
                                        text: root.primary-text;
                                        enabled: root.can-encode;
                                        description: root.encode-status;
                                        clicked => {
                                            root.encode-requested();
                                        }
                                    }

                                    if !root.can-encode && root.encode-status != "": Caption {
                                        text: root.encode-status;
                                        color: root.encode-status-tone == Tone.neutral ? Tokens.text-secondary : Tones.color(root.encode-status-tone);
                                        font-weight: root.encode-status-tone == Tone.error ? Tokens.weight-semibold : Tokens.weight-regular;
                                        horizontal-alignment: center;
                                        accessible-live-region: polite;
                                    }
                                }

                                if root.job-active: VerticalLayout {
                                    spacing: Tokens.space-2;

                                    HorizontalLayout {
                                        spacing: Tokens.space-3;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.job-headline;
                                            color: Tokens.text;
                                            font-size: Tokens.type-body * 1rem;
                                            font-weight: Tokens.weight-semibold;
                                            overflow: elide;
                                            accessible-live-region: polite;
                                        }

                                        if root.run-position != "": Text {
                                            text: root.run-position;
                                            color: Tokens.text-secondary;
                                            font-size: Tokens.type-body * 1rem;
                                            accessible-label: "File " + root.run-position;
                                        }

                                        Text {
                                            text: root.elapsed-text;
                                            color: Tokens.text-secondary;
                                            font-size: Tokens.type-body * 1rem;
                                            accessible-label: "Elapsed " + root.elapsed-text;
                                        }
                                    }

                                    Bar {
                                        known: root.progress-known;
                                        fraction: root.progress-fraction;
                                        value-text: root.progress-text;
                                    }

                                    Caption {
                                        text: root.progress-line;
                                        wrap: no-wrap;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: Tokens.space-3;
                                        padding-top: Tokens.space-1;

                                        Caption {
                                            horizontal-stretch: 1;
                                            text: root.job-detail;
                                            vertical-alignment: center;
                                        }

                                        Button {
                                            text: root.job-view == JobView.cancelling ? "Cancelling…" : "Cancel";
                                            enabled: root.job-view == JobView.running;
                                            accessible-description: "Stop converting. Nothing is published.";
                                            clicked => {
                                                root.cancel-requested();
                                            }
                                        }
                                    }
                                }

                                if root.job-view == JobView.completed: VerticalLayout {
                                    spacing: Tokens.space-3;

                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        HorizontalLayout {
                                            spacing: Tokens.space-2;

                                            StatusDot {
                                                tone: root.job-tone;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.job-headline;
                                                color: Tokens.text;
                                                font-size: Tokens.type-body * 1rem;
                                                font-weight: Tokens.weight-semibold;
                                                overflow: elide;
                                                accessible-live-region: polite;
                                            }
                                        }

                                        Caption {
                                            text: root.job-detail;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        for check in root.job-checks: HorizontalLayout {
                                            spacing: Tokens.space-2;
                                            accessible-role: text;
                                            accessible-label: check.name + ": " + check.outcome + (check.detail != "" ? ". " + check.detail : "");

                                            Text {
                                                width: 56px;
                                                text: check.outcome;
                                                color: Tones.color(check.tone);
                                                font-size: Tokens.type-caption * 1rem;
                                                font-weight: Tokens.weight-bold;
                                                accessible-role: none;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: check.name + (check.detail != "" ? " — " + check.detail : "");
                                                color: Tokens.text-secondary;
                                                font-size: Tokens.type-caption * 1rem;
                                                wrap: word-wrap;
                                                accessible-role: none;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Tokens.space-3;

                                        PrimaryButton {
                                            text: "Show in Folder";
                                            description: "Show the converted file in the file manager";
                                            clicked => {
                                                root.reveal-requested();
                                            }
                                        }

                                        if root.can-analyze-result: Button {
                                            text: "Open in Analyze";
                                            accessible-description: "Inspect the converted file's OBUs and bytes, without reading it in again as a source";
                                            clicked => {
                                                root.analyze-result-requested();
                                            }
                                        }

                                        if root.can-compare-result: Button {
                                            text: "Compare with Source";
                                            accessible-description: "Pair the converted file with the source that its job read. Studio checks the size and time of the source and the size and picture count of the result.";
                                            clicked => {
                                                root.compare-result-requested();
                                            }
                                        }

                                        Button {
                                            text: "Convert Another";
                                            accessible-description: "Clear this result and choose another video";
                                            clicked => {
                                                root.reset-requested();
                                            }
                                        }
                                    }

                                    if root.reveal-error != "": Text {
                                        text: root.reveal-error;
                                        color: Tokens.error;
                                        font-size: Tokens.type-caption * 1rem;
                                        wrap: word-wrap;
                                        accessible-live-region: polite;
                                    }
                                }
                            }

                            if root.advanced-custom && root.show-settings: Caption {
                                text: "Custom — based on speed preset " + root.preset;
                            }

                            HorizontalLayout {
                                alignment: start;

                                LinkButton {
                                    text: root.advanced-open ? "Hide Advanced  ‹" : "Advanced  ›";
                                    description: "Encoder options, output destination, and source details";
                                    accessible-expandable: true;
                                    accessible-expanded: root.advanced-open;
                                    clicked => {
                                        root.advanced-open = !root.advanced-open;
                                    }
                                }
                            }
                        }

                        // Advanced stays in the same viewport at either width.
                        if root.advanced-open: HorizontalLayout {
                                spacing: root.card-padding;
                                padding-left: root.compact-advanced ? 0px : root.card-padding;

                                if !root.compact-advanced: Rectangle {
                                    width: 1px;
                                    background: Tokens.border;
                                }

                                VerticalLayout {
                                    width: root.advanced-width;
                                    spacing: Tokens.space-3;
                                    alignment: start;
                                    accessible-role: groupbox;
                                    accessible-label: "Advanced";

                                    if root.compact-advanced: HorizontalLayout {
                                        alignment: start;

                                        LinkButton {
                                            text: "‹ Simple";
                                            description: "Return to Simple. Keep the current configuration.";
                                            clicked => { root.advanced-open = false; }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        Label {
                                            text: "Output format";
                                        }

                                        ComboBox {
                                            model: root.output-labels;
                                            current-index <=> root.output-index;
                                            enabled: !root.locked && root.advanced-open;
                                            accessible-label: "Output format";
                                            selected => {
                                                root.output-selected(self.current-index);
                                            }
                                        }

                                        Caption {
                                            text: "Video only; audio and subtitles are not written.";
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Tokens.space-4;

                                        VerticalLayout {
                                            spacing: Tokens.space-1;

                                            Label {
                                                text: "Rate factor";
                                            }

                                            SpinBox {
                                                minimum: root.crf-min;
                                                maximum: root.crf-max;
                                                value <=> root.crf;
                                                enabled: !root.locked && root.advanced-open;
                                                accessible-label: "Rate factor";
                                                accessible-description: root.crf-min + " to " + root.crf-max + ". Higher means fewer bits.";
                                                edited(value) => {
                                                    root.crf-edited(value);
                                                }
                                            }

                                            Caption {
                                                text: root.rate-overridden ? "Used when rate control inherits from Simple." : root.crf-min + "–" + root.crf-max + ", higher is smaller";
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: Tokens.space-1;

                                            Label {
                                                text: "Speed preset";
                                            }

                                            SpinBox {
                                                minimum: root.preset-min;
                                                maximum: root.preset-max;
                                                value <=> root.advanced-preset-candidate;
                                                enabled: !root.locked && root.advanced-open;
                                                accessible-label: "Preview a speed preset";
                                                accessible-description: root.preset-min + " to " + root.preset-max + ". Higher is faster.";
                                                edited(value) => {
                                                    root.advanced-preview-preset(value);
                                                }
                                            }

                                            Caption {
                                                text: root.preset-min + "–" + root.preset-max + ", higher is faster";
                                            }
                                        }
                                    }

                                    AdvancedEditor {
                                        options: root.advanced-options;
                                        fields: root.advanced-fields;
                                        selected: root.advanced-selected;
                                        label: root.advanced-label;
                                        help: root.advanced-help;
                                        effective: root.advanced-effective;
                                        origin: root.advanced-origin;
                                        screen: root.advanced-screen;
                                        error: root.advanced-error;
                                        status: root.advanced-status;
                                        preset-preview: root.advanced-preset-preview;
                                        imported-preview: root.advanced-imported-preview;
                                        preset-files-ready: root.advanced-preset-files-ready;
                                        preset-file-error: root.advanced-preset-file-error;
                                        preset-file-status: root.advanced-preset-file-status;
                                        can-undo: root.advanced-can-undo;
                                        can-redo: root.advanced-can-redo;
                                        can-apply-preset: root.advanced-can-apply-preset;
                                        editable: !root.locked && !root.sheet-open;
                                        focus-request: root.advanced-focus-request;
                                        focus-field: root.advanced-focus-field;
                                        draft-reset: root.advanced-draft-reset;
                                        query <=> root.advanced-query;
                                        modified-only <=> root.advanced-modified-only;
                                        expert <=> root.advanced-expert-enabled;
                                        search(query) => { root.advanced-search(query); }
                                        modified(enabled) => { root.advanced-modified(enabled); }
                                        show-expert(enabled) => { root.advanced-expert(enabled); }
                                        select(key) => { root.advanced-select(key); }
                                        edit(id, value) => {
                                            if root.advanced-draft-field == id && root.advanced-draft-option == root.advanced-selected {
                                                root.advanced-draft-field = "";
                                            }
                                            root.advanced-edit(id, value);
                                        }
                                        draft-edited(id, value) => {
                                            root.advanced-draft-option = root.advanced-selected;
                                            root.advanced-draft-field = id;
                                            root.advanced-draft-text = value;
                                        }
                                        reset(scope) => { root.advanced-reset(scope); }
                                        undo => { root.advanced-undo(); }
                                        redo => { root.advanced-redo(); }
                                        apply-preset => { root.advanced-apply-preset(); }
                                        save-preset => { root.advanced-save-preset(); }
                                        import-preset => { root.advanced-import-preset(); }
                                        cancel-preset => {
                                            root.advanced-preset-candidate = root.preset;
                                            root.advanced-preview-preset(root.preset);
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        HorizontalLayout {
                                            Label {
                                                text: "Output file";
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }

                                            LinkButton {
                                                text: "Choose…";
                                                enabled: root.has-destination && root.destination-editable && root.advanced-open && !root.sheet-open;
                                                description: "Choose where to save the converted file";
                                                clicked => {
                                                    root.choose-destination-requested();
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.has-destination ? root.destination-path : "Open a video first.";
                                            color: root.has-destination ? Tokens.text : Tokens.text-secondary;
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: char-wrap;
                                            accessible-label: root.has-destination ? "Output file: " + root.destination-path : "No output file yet";
                                        }

                                        if root.destination-warning != "": Text {
                                            text: root.destination-warning;
                                            color: Tokens.warning;
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: word-wrap;
                                        }

                                        Caption {
                                            text: root.destination-help;
                                        }
                                    }

                                    if root.detail-headline != "": VerticalLayout {
                                        spacing: Tokens.space-1;

                                        SectionTitle {
                                            text: "RESULT";
                                        }

                                        HorizontalLayout {
                                            spacing: Tokens.space-2;

                                            StatusDot {
                                                tone: root.detail-tone;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: root.detail-headline;
                                                color: Tokens.text;
                                                font-size: Tokens.type-caption * 1rem;
                                                font-weight: Tokens.weight-semibold;
                                                wrap: word-wrap;
                                            }
                                        }

                                        if root.detail-text != "": Text {
                                            text: root.detail-text;
                                            color: Tokens.text;
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: word-wrap;
                                        }

                                        for check in root.detail-checks: HorizontalLayout {
                                            spacing: Tokens.space-2;
                                            accessible-role: text;
                                            accessible-label: check.name + ": " + check.outcome + (check.detail != "" ? ". " + check.detail : "");

                                            Text {
                                                width: 56px;
                                                text: check.outcome;
                                                color: Tones.color(check.tone);
                                                font-size: Tokens.type-caption * 1rem;
                                                font-weight: Tokens.weight-bold;
                                                accessible-role: none;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: check.name + (check.detail != "" ? " — " + check.detail : "");
                                                color: Tokens.text-secondary;
                                                font-size: Tokens.type-caption * 1rem;
                                                wrap: word-wrap;
                                                accessible-role: none;
                                            }
                                        }

                                        // The list's converted row; one file has a button.
                                        if root.can-analyze-result && root.view-mode == ViewMode.list: HorizontalLayout {
                                            alignment: start;
                                            spacing: Tokens.space-4;

                                            LinkButton {
                                                text: "Open in Analyze";
                                                description: "Inspect the converted file's OBUs and bytes, without reading it in again as a source";
                                                clicked => {
                                                    root.analyze-result-requested();
                                                }
                                            }

                                            if root.can-compare-result: LinkButton {
                                                text: "Compare with Source";
                                                description: "Pair the converted file with the source that its job read. Studio checks the size and time of the source and the size and picture count of the result.";
                                                clicked => {
                                                    root.compare-result-requested();
                                                }
                                            }
                                        }
                                    }

                                    if root.has-track-picker: VerticalLayout {
                                        spacing: Tokens.space-1;

                                        Label {
                                            text: "Video track";
                                        }

                                        ComboBox {
                                            model: root.track-labels;
                                            current-index <=> root.track-index;
                                            enabled: root.destination-editable && root.advanced-open && root.source-view != SourceView.probing;
                                            accessible-label: "Video track";
                                            accessible-description: "The one video track that is converted";
                                            selected => {
                                                root.track-selected(self.current-index);
                                            }
                                        }

                                        if root.track-note != "": Caption {
                                            text: root.track-note;
                                        }
                                    }

                                    if root.has-source-facts: VerticalLayout {
                                        spacing: Tokens.space-1;

                                        SectionTitle {
                                            text: "SOURCE";
                                        }

                                        for fact in root.source-facts: FactRow {
                                            label: fact.label;
                                            value: fact.value;
                                        }

                                        for disclosure in root.source-disclosures: Text {
                                            text: disclosure;
                                            color: Tokens.text;
                                            font-size: Tokens.type-caption * 1rem;
                                            wrap: word-wrap;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Tokens.space-1;

                                        if root.preview-note != "": Caption {
                                            text: root.preview-note;
                                        }

                                        Caption {
                                            text: "Engine: " + root.engine-identity;
                                        }

                                        Caption {
                                            text: root.media-tool-line;
                                        }
                                    }
                                }
                        }
                    }
                    }
                }
        }
    }

    // Copies to the clipboard through a hidden text field: the platform
    // clipboard is only reachable from a text element.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }

    clip := TextInput {
        visible: false;
        read-only: true;
    }

    // The video-only confirmation. Modal: clicks outside it reach nothing,
    // Tab stays inside it, Escape is Cancel. Cancel has the initial focus, so
    // Enter or Space never converts by accident; converting takes a
    // deliberate Tab or click.
    sheet := PopupWindow {
        close-policy: no-auto-close;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        Rectangle {
            background: Tokens.dark ? #00000080 : #18181d40;

            // Absorbs clicks on the scrim.
            TouchArea { }

            // Only catches Escape bubbling up from the buttons; never a Tab stop.
            FocusScope {
                focus-on-tab-navigation: false;
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.omissions-declined();
                        return accept;
                    }
                    reject
                }

                Rectangle {
                    width: min(392px, root.width - 2 * Tokens.space-6);
                    height: card.preferred-height;
                    x: (parent.width - self.width) / 2;
                    y: max(Tokens.space-3, (parent.height - self.height) / 2.5);
                    background: Tokens.raised;
                    border-color: Tokens.border;
                    border-width: 1px;
                    border-radius: Tokens.radius-large;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #0000004d;
                    drop-shadow-offset-y: 8px;
                    accessible-role: groupbox;
                    accessible-label: "Convert video only?";
                    accessible-description: root.sheet-body;

                    card := VerticalLayout {
                        padding: Tokens.space-6;
                        spacing: Tokens.space-3;

                        Text {
                            text: "Convert video only?";
                            color: Tokens.text;
                            font-size: Tokens.type-title * 1rem;
                            font-weight: Tokens.weight-semibold;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.sheet-body;
                            color: Tokens.text;
                            font-size: Tokens.type-body * 1rem;
                            wrap: word-wrap;
                        }

                        if root.sheet-items.length > 0: VerticalLayout {
                            spacing: Tokens.space-1;

                            for line in root.sheet-items: HorizontalLayout {
                                spacing: Tokens.space-2;

                                Text {
                                    text: "•";
                                    color: Tokens.text-secondary;
                                    font-size: Tokens.type-caption * 1rem;
                                    accessible-role: none;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: line;
                                    color: Tokens.text;
                                    font-size: Tokens.type-caption * 1rem;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: Tokens.space-2;
                            padding-top: Tokens.space-1;

                            if root.confirm-first: PrimaryButton {
                                horizontal-stretch: 0;
                                text: "Convert Video Only";
                                description: root.sheet-body;
                                clicked => {
                                    root.omissions-confirmed();
                                }
                            }

                            cancel-sheet := Button {
                                text: "Cancel";
                                accessible-description: "Do not convert";
                                init => {
                                    self.focus();
                                }
                                clicked => {
                                    root.omissions-declined();
                                }
                            }

                            if !root.confirm-first: PrimaryButton {
                                horizontal-stretch: 0;
                                text: "Convert Video Only";
                                description: root.sheet-body;
                                clicked => {
                                    root.omissions-confirmed();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    validation-setup := PopupWindow {
        close-policy: no-auto-close;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        ValidationSetup {
            strict <=> root.validation-strict;
            busy: root.validation-busy;
            context: root.validation-context;
            notice: root.validation-notice;
            cancel => { root.validation-cancel(); }
            choose-files => { root.validation-choose-files(); }
            pick-context => { root.validation-pick-context(); }
            clear-context => { root.validation-clear-context(); }
        }
    }

    export-setup := PopupWindow {
        close-policy: no-auto-close;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;

        ExportSetup { }
    }

    jobs-popup := PopupWindow {
        close-policy: close-on-click-outside;
        width: min(420px, root.width - 2 * Tokens.space-3);
        // Slint sets the popup size when it opens. Keep the viewport large enough
        // for a preview to appear later, and scroll its content within it.
        height: min(min(480px, 236px + 84px * root.jobs.length), root.height - 2 * Tokens.space-6);
        x: root.width - self.width - Tokens.space-3;
        y: Tokens.space-6;

        Rectangle {
            background: Tokens.raised;
            border-color: Tokens.border;
            border-width: 1px;
            border-radius: Tokens.radius-large;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0000004d;
            drop-shadow-offset-y: 8px;
            accessible-role: groupbox;
            accessible-label: "Jobs";

            // Another number of jobs gives every row new controls, so a
            // focused Show or Cancel is gone: the focus goes to Close.
            property <int> count: root.jobs.length;
            changed count => {
                jobs-close.focus();
            }

            // Escape bubbling up from the controls closes the list; never a
            // Tab stop.
            FocusScope {
                focus-on-tab-navigation: false;
                focus-on-click: false;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        jobs-popup.close();
                        return accept;
                    }
                    reject
                }

                VerticalLayout {
                    padding: Tokens.space-4;
                    spacing: Tokens.space-3;

                    Text {
                        text: "Jobs";
                        color: Tokens.text;
                        font-size: Tokens.type-title * 1rem;
                        font-weight: Tokens.weight-semibold;
                    }

                    Caption {
                        text: root.jobs.length == 0
                            ? "Encodes, stream reads, validations and exports appear here."
                            : "Jobs run while the window is open.";
                    }

                    if root.validation-job-notice != "": Caption {
                        text: root.validation-job-notice;
                        wrap: word-wrap;
                    }

                    if root.validation-active: HorizontalLayout {
                        alignment: start;
                        LinkButton {
                            text: "Stop Validation Batch";
                            description: "Cancel the remaining validation files and keep completed results";
                            clicked => {
                                root.stop-validation-batch();
                                jobs-close.focus();
                            }
                        }
                    }

                    if DecodeExport.job-notice != "": Caption {
                        text: DecodeExport.job-notice;
                        wrap: word-wrap;
                        accessible-live-region: polite;
                    }

                    if DecodeExport.active: HorizontalLayout {
                        alignment: start;
                        LinkButton {
                            text: "Stop Export Batch";
                            description: "Cancel remaining exports and keep completed files.";
                            clicked => {
                                DecodeExport.cancel-batch();
                                jobs-close.focus();
                            }
                        }
                    }

                    if root.report-dialog-error != "": Caption {
                        text: root.report-dialog-error;
                        color: Tokens.error;
                        wrap: word-wrap;
                    }

                    ScrollView {
                        min-height: 0px;
                        content-width: self.visible-width;
                        content-height: jobs-body.preferred-height;
                        horizontal-scrollbar-policy: always-off;

                        jobs-body := VerticalLayout {
                            width: parent.visible-width;
                            height: self.preferred-height;
                            spacing: Tokens.space-3;
                            padding-right: Tokens.space-4;

                            if root.job-can-generate-pass && root.job-related-title == "": HorizontalLayout {
                                alignment: start;
                                LinkButton {
                                    text: "Generate first pass…";
                                    description: "Review a first pass for the selected source and its variable bitrate settings";
                                    clicked => { root.job-generate-pass(); }
                                }
                            }

                            if root.job-related-title != "": VerticalLayout {
                                spacing: Tokens.space-2;
                                Label {
                                    text: root.job-related-title;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    spacing: Tokens.space-2;

                                    if root.job-related-ready: Button {
                                        text: "Confirm";
                                        accessible-label: "Confirm " + root.job-related-title;
                                        clicked => { root.job-related-approve(); }
                                    }

                                    LinkButton {
                                        text: root.job-related-failed ? "Dismiss" : "Cancel";
                                        description: "Close this job preview";
                                        init => { self.focus(); }
                                        clicked => { root.job-related-decline(); }
                                    }
                                }

                                if root.job-related-detail != "": Caption {
                                    text: root.job-related-detail;
                                    color: root.job-related-failed ? Tokens.error : Tokens.text-secondary;
                                    wrap: char-wrap;
                                }
                            }

                            if root.jobs.length > 0: JobList {
                                jobs: root.jobs;
                                actions-enabled: root.job-actions-enabled;
                                // Closing first would remove the handler.
                                show(i) => {
                                    root.job-show(i);
                                    jobs-popup.close();
                                }
                                cancel(i) => {
                                    root.job-cancel(i);
                                    jobs-close.focus();
                                }
                                action(i, action) => {
                                    root.job-action(i, action);
                                }
                                export-report(i, json) => {
                                    root.job-export(i, json);
                                }
                                remove(i) => {
                                    root.job-remove(i);
                                    jobs-close.focus();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;

                        jobs-close := Button {
                            text: "Close";
                            init => {
                                self.focus();
                            }
                            clicked => {
                                jobs-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    about := PopupWindow {
        close-policy: close-on-click-outside;
        width: min(440px, root.width - 2 * Tokens.space-3);
        x: (root.width - self.width) / 2;
        y: max(0px, (root.height - self.height) / 3);

        Rectangle {
            background: Tokens.raised;
            border-color: Tokens.border;
            border-width: 1px;
            border-radius: Tokens.radius-large;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0000004d;
            drop-shadow-offset-y: 8px;
            accessible-role: groupbox;
            accessible-label: "About Splot Studio";

            VerticalLayout {
                padding: Tokens.space-6;
                spacing: Tokens.space-3;

                Wordmark {
                    size: Tokens.type-display * 1rem;
                    alignment: center;
                }

                Text {
                    text: "Splot Studio " + root.app-version;
                    color: Tokens.text;
                    font-size: Tokens.type-body * 1rem;
                    font-weight: Tokens.weight-semibold;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Copyright © 2026 Bartosz Tomczyk. Licensed under the PolyForm Noncommercial License 1.0.0 (polyformproject.org/licenses/noncommercial/1.0.0). Source-available, not open source. Commercial use requires a separate written commercial license from Bartosz Tomczyk.";
                    color: Tokens.text-secondary;
                    font-size: Tokens.type-caption * 1rem;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "Third-party components keep their own licenses.";
                    color: Tokens.text-secondary;
                    font-size: Tokens.type-caption * 1rem;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                AboutSlint {
                    preferred-height: self.min-height;
                }

                HorizontalLayout {
                    alignment: end;

                    Button {
                        text: "Close";
                        clicked => {
                            about.close();
                        }
                    }
                }
            }
        }
    }
}

// Shown instead of the main window when the app cannot start: another Splot
// Studio already owns the list of files (only one may run, so that list is
// never written twice), or this processor is below the release CPU floor.
export component NoticeWindow inherits Window {
    in property <string> heading;
    in property <string> message;
    callback quit-requested();

    title: "Splot Studio";
    background: Tokens.raised;
    min-width: 408px;
    max-width: 408px;
    min-height: card.preferred-height;
    max-height: card.preferred-height;

    card := VerticalLayout {
        padding: Tokens.space-6;
        spacing: Tokens.space-3;

        HorizontalLayout {
            alignment: start;

            Wordmark { }
        }

        Text {
            text: root.heading;
            color: Tokens.text;
            font-size: Tokens.type-title * 1rem;
            font-weight: Tokens.weight-semibold;
            wrap: word-wrap;
            accessible-live-region: polite;
        }

        Caption {
            text: root.message;
        }

        HorizontalLayout {
            alignment: end;
            padding-top: Tokens.space-2;

            Button {
                text: "Quit";
                accessible-description: "Close this window";
                init => {
                    self.focus();
                }
                clicked => {
                    root.quit-requested();
                }
            }
        }
    }
}
