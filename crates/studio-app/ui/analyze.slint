// The Analyze workspace: a navigator of the document's elements, the
// selected element's properties and the bytes around it. Rust owns every
// value through the `Analysis` global, including the selection, the
// visible rows and the byte window; every callback is an input that Rust
// answers by setting the global again. Only the visible rows and one byte
// window exist here, however large the file. Nothing here reads files.

import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { DecodeExport, ExportPurpose } from "export-setup.slint";
import { FocusRing, KeyboardFocus } from "focus.slint";
import { Caption, LinkButton, WorkspaceSwitch } from "controls.slint";
import { IconButton, Playback, PlaybackPanel, StageState, ToggleChip } from "stage.slint";

// What the shown document is doing; `empty` when none is open.
// `attention`: a restored document whose file changed or is missing.
export enum AnalysisState { empty, opening, open, failed, attention }

// A keyboard movement in the navigator or the byte view; `none` for a key
// that is no movement.
export enum NavStep { none, up, down, page-up, page-down, home, end, left, right }

// The movement a key asks for, the same in the navigator and the bytes.
global Steps {
    public pure function of(key: string) -> NavStep {
        return key == Key.UpArrow ? NavStep.up
            : key == Key.DownArrow ? NavStep.down
            : key == Key.PageUp ? NavStep.page-up
            : key == Key.PageDown ? NavStep.page-down
            : key == Key.Home ? NavStep.home
            : key == Key.End ? NavStep.end
            : key == Key.LeftArrow ? NavStep.left
            : key == Key.RightArrow ? NavStep.right
            : NavStep.none;
    }
}

// Which part of the selected element a byte belongs to, from the spans the
// engine reported; `outside` for bytes of other elements.
export enum ByteRegion { outside, prefix, header, payload, record-header, file-header, unparsed }

// One visible navigator row; `loaded` is false until its page arrives.
export struct NavRow {
    loaded: bool,
    // 1 for an OBU or region inside an IVF packet.
    depth: int,
    title: string,
    detail: string,
    offset: string,
    selected: bool,
    accessible: string,
}

// One property of the inspector.
export struct Property {
    label: string,
    value: string,
    note: string,
}

// One byte of the window.
export struct ByteCell {
    text: string,
    region: ByteRegion,
    cursor: bool,
    evidence: bool,
}

// One line of the byte window.
export struct ByteLine {
    offset: string,
    cells: [ByteCell],
    ascii: string,
}

// One entry of the byte legend.
export struct Legend {
    label: string,
    region: ByteRegion,
}

// A syntax observation or validation finding on the current page.
export struct EvidenceRow {
    depth: int,
    label: string,
    detail: string,
    selected: bool,
    accessible: string,
}

export global Analysis {
    in property <AnalysisState> state;
    in property <[string]> documents;
    in-out property <int> document-index;
    in property <string> summary-line;
    in property <string> outcome-line;
    in property <bool> outcome-problem;
    // Opening and failed states, and the empty state's caption.
    in property <string> message;
    // A problem that did not end the document.
    in property <string> notice;
    // The attention state's heading and its way out.
    in property <string> heading;
    in property <string> action;
    in property <string> action-description;
    // The read was cancelled and kept only the start of the file.
    in property <bool> can-read-again;
    in property <bool> can-cancel-read;
    in property <bool> reading;
    in property <bool> can-playback;

    in property <[string]> type-labels;
    in-out property <int> type-index;
    in property <[string]> layer-labels;
    in-out property <int> layer-index;
    in property <bool> filtered;
    in property <string> rows-line;
    in property <string> hidden-note;

    in property <[NavRow]> rows;
    // How many rows the navigator shows; Rust sends at most this many.
    in property <int> visible-rows: 12;
    in property <int> total-rows;
    in property <int> top-row;
    in property <bool> can-back;
    in property <bool> can-forward;

    in property <string> inspector-title;
    in property <[Property]> properties;
    // What Copy Row and Copy Offset copy; empty without a selection.
    in property <string> selected-line;
    in property <string> selected-offset;

    in property <bool> bytes-shown;
    in property <string> bytes-title;
    in property <[ByteLine]> byte-lines;
    in property <[Legend]> legend;
    // The byte under the cursor, in words.
    in property <string> cursor-line;

    in property <int> evidence-tab;
    in property <string> syntax-status;
    in property <string> findings-status;
    in property <[EvidenceRow]> evidence-rows;
    in property <string> evidence-detail;
    in property <string> evidence-note;
    in property <string> evidence-copy;
    in property <string> evidence-page-label;
    in-out property <string> evidence-query;
    in-out property <string> evidence-rule-query;
    in-out property <int> severity-index;
    in property <[string]> finding-layers;
    in-out property <int> finding-layer-index;
    in property <bool> evidence-can-prev;
    in property <bool> evidence-can-next;
    in property <bool> finding-can-prev;
    in property <bool> finding-can-next;
    in property <bool> validation-running;

    callback evidence-view(int);
    callback evidence-search(string);
    callback evidence-rule(string);
    callback evidence-severity(int);
    callback evidence-layer(int);
    callback evidence-pick(int);
    callback evidence-move(NavStep);
    callback evidence-page(int);
    callback finding-step(int);
    callback validate-stream();
    callback cancel-validation();

    callback open();
    callback close();
    callback reopen();
    callback cancel();
    callback resolve();
    callback show(int);
    callback row-clicked(int);
    callback move(NavStep);
    callback scroll(int);
    callback scroll-to(float);
    callback byte-clicked(int);
    callback cursor(NavStep);
    callback select-at-cursor();
    callback toggle-bytes();
    callback toggle-playback();
    callback back();
    callback forward();
    callback go-to(string);
    callback type-filter(int);
    callback layer-filter(int);
    callback clear-filters();

    public pure function tint(region: ByteRegion) -> color {
        return region == ByteRegion.prefix ? Tokens.accent.transparentize(0.55)
            : region == ByteRegion.header ? Tokens.accent.transparentize(0.3)
            : region == ByteRegion.payload ? Tokens.accent.transparentize(0.8)
            : region == ByteRegion.record-header || region == ByteRegion.file-header ? Tokens.border-strong
            : region == ByteRegion.unparsed ? Tokens.error.transparentize(0.7)
            : transparent;
    }
}

// The navigator: the visible rows of the document, one Tab stop. Up and
// Down (Page Up, Page Down, Home, End) select, Left selects the packet that
// holds the selection and Right its first OBU. The wheel and the bar on the
// right scroll.
component Navigator inherits KeyboardFocus {
    in property <length> row-height: 24px;
    property <int> visible-rows: Analysis.visible-rows;

    property <int> count: Analysis.rows.length;
    property <length> track: root.visible-rows * root.row-height;
    property <length> thumb: Analysis.total-rows <= root.visible-rows ? root.track
        : max(24px, root.track * root.visible-rows / Analysis.total-rows);
    height: root.track;
    accessible-role: list;
    accessible-label: "Elements";
    accessible-description: Analysis.rows-line + ". Up and Down select, Left selects the packet that holds the selection.";
    key-pressed(event) => {
        let step = Steps.of(event.text);
        if step == NavStep.none {
            return reject;
        }
        root.keyboard-used();
        Analysis.move(step);
        accept
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-small;
    }

    TouchArea {
        scroll-event(event) => {
            if event.delta-y != 0 {
                Analysis.scroll(event.delta-y > 0 ? min(-1, round(-event.delta-y / root.row-height))
                    : max(1, round(-event.delta-y / root.row-height)));
                return accept;
            }
            reject
        }
    }

    for row[i] in Analysis.rows: Rectangle {
        x: 0;
        y: i * root.row-height;
        width: root.width - 10px;
        height: root.row-height;
        background: row.selected ? Tokens.row-selected : touch.has-hover ? Tokens.row-hover : transparent;
        accessible-role: list-item;
        accessible-label: row.accessible;
        accessible-item-selectable: row.loaded;
        accessible-item-selected: row.selected;
        accessible-item-index: Analysis.top-row + i;
        accessible-item-count: Analysis.total-rows;
        accessible-action-default => {
            Analysis.row-clicked(i);
        }

        touch := TouchArea {
            enabled: row.loaded;
            mouse-cursor: row.loaded ? pointer : default;
            clicked => {
                root.focus();
                Analysis.row-clicked(i);
            }
        }

        // The selection's bar: its shape says what the tint says.
        if row.selected: Rectangle {
            x: 0;
            width: 3px;
            height: parent.height;
            background: Tokens.accent;
        }

        HorizontalLayout {
            padding-left: Tokens.space-2 + row.depth * Tokens.space-4;
            padding-right: Tokens.space-2;
            spacing: Tokens.space-2;

            Text {
                horizontal-stretch: 1;
                text: row.loaded ? row.title : "Loading…";
                color: row.loaded ? Tokens.text : Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                font-weight: row.selected ? Tokens.weight-semibold : Tokens.weight-regular;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            Text {
                horizontal-stretch: 0;
                text: row.detail;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                vertical-alignment: center;
                accessible-role: none;
            }

            // As wide as the offset needs (16 hex digits at most), so it is
            // never cut; the title gives up the room.
            Text {
                width: max(48px, self.preferred-width);
                text: row.offset;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                font-family: "monospace";
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }

    // Where the visible rows are among all of them; drag or click to move.
    if Analysis.total-rows > root.visible-rows: Rectangle {
        x: root.width - 6px;
        width: 6px;
        height: root.track;
        border-radius: 3px;
        background: Tokens.track;

        Rectangle {
            y: (root.track - root.thumb) * Analysis.top-row / max(1, Analysis.total-rows - root.visible-rows);
            width: parent.width;
            height: root.thumb;
            border-radius: 3px;
            background: Tokens.border-strong;
        }

        bar := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    Analysis.scroll-to(max(0, min(1, (self.mouse-y - root.thumb / 2) / max(1px, root.track - root.thumb))));
                }
            }
            moved => {
                if self.pressed {
                    Analysis.scroll-to(max(0, min(1, (self.mouse-y - root.thumb / 2) / max(1px, root.track - root.thumb))));
                }
            }
        }
    }
}

// The selected element's properties, one Tab stop. Up and Down choose a
// property; Command or Control+C copies its value.
component Inspector inherits KeyboardFocus {
    in-out property <int> current: 0;
    callback copy(string);

    property <int> count: Analysis.properties.length;
    accessible-role: list;
    accessible-label: "Properties of " + Analysis.inspector-title;
    key-pressed(event) => {
        if root.count == 0 {
            return reject;
        }
        if event.text == Key.DownArrow {
            root.keyboard-used();
            root.current = min(root.count - 1, root.current + 1);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.keyboard-used();
            root.current = max(0, root.current - 1);
            return accept;
        }
        if event.modifiers.control && (event.text == "c" || event.text == "C") {
            root.copy(Analysis.properties[min(root.current, root.count - 1)].value);
            return accept;
        }
        reject
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-small;
    }

    ScrollView {
        VerticalLayout {
        alignment: start;

        for property[i] in Analysis.properties: HorizontalLayout {
            padding-left: Tokens.space-2;
            padding-right: Tokens.space-2;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: Tokens.space-2;
            accessible-role: list-item;
            accessible-label: property.label + ": " + property.value + (property.note != "" ? ". " + property.note : "");
            accessible-item-selectable: true;
            accessible-item-selected: i == root.current;
            accessible-item-index: i;
            accessible-item-count: root.count;

            Rectangle {
                width: 3px;
                background: root.has-focus && i == root.current ? Tokens.accent : transparent;
            }

            Text {
                width: 92px;
                text: property.label;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                accessible-role: none;
            }

            VerticalLayout {
                horizontal-stretch: 1;

                Text {
                    text: property.value;
                    color: Tokens.text;
                    font-size: Tokens.type-caption * 1rem;
                    font-weight: i == root.current && root.has-focus ? Tokens.weight-semibold : Tokens.weight-regular;
                    wrap: word-wrap;
                    accessible-role: none;
                }

                if property.note != "": Text {
                    text: property.note;
                    color: Tokens.text-secondary;
                    font-size: Tokens.type-caption * 0.9rem;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }

            TouchArea {
                clicked => {
                    root.focus();
                    root.current = i;
                }
            }
        }
        }
    }
}

// One page of the active evidence list. Rust owns its selection and paging.
component EvidenceList inherits KeyboardFocus {
    callback copy(string);

    height: max(24px, Analysis.evidence-rows.length * 24px);
    accessible-role: list;
    accessible-label: Analysis.evidence-tab == 1 ? "Syntax observations" : "Validation findings";
    accessible-description: Analysis.evidence-page-label + ". Use the arrow keys to choose a row.";
    key-pressed(event) => {
        if event.modifiers.control && (event.text == "c" || event.text == "C") && Analysis.evidence-copy != "" {
            root.copy(Analysis.evidence-copy);
            return accept;
        }
        let step = Steps.of(event.text);
        if step == NavStep.none {
            return reject;
        }
        root.keyboard-used();
        Analysis.evidence-move(step);
        accept
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-small;
    }

    for row[i] in Analysis.evidence-rows: Rectangle {
        x: 0;
        y: i * 24px;
        height: 24px;
        width: root.width;
        background: row.selected ? Tokens.row-selected : hit.has-hover ? Tokens.row-hover : transparent;
        accessible-role: list-item;
        accessible-label: row.accessible;
        accessible-item-selectable: true;
        accessible-item-selected: row.selected;
        accessible-item-index: i;
        accessible-item-count: Analysis.evidence-rows.length;
        accessible-action-default => {
            Analysis.evidence-pick(i);
        }

        if row.selected: Rectangle {
            x: 0;
            width: 3px;
            height: parent.height;
            background: Tokens.accent;
        }

        HorizontalLayout {
            padding-left: Tokens.space-2 + min(8, row.depth) * Tokens.space-2;
            padding-right: Tokens.space-2;
            spacing: Tokens.space-2;

            Text {
                horizontal-stretch: 1;
                text: row.label;
                color: Tokens.text;
                font-size: Tokens.type-caption * 1rem;
                font-weight: row.selected ? Tokens.weight-semibold : Tokens.weight-regular;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }

            if row.detail != "": Text {
                max-width: 128px;
                text: row.detail;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
        }

        hit := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.focus();
                Analysis.evidence-pick(i);
            }
        }
    }
}

component EvidencePane inherits VerticalLayout {
    callback copy(string);
    property <bool> findings: Analysis.evidence-tab == 2;
    spacing: Tokens.space-1;

    HorizontalLayout {
        spacing: Tokens.space-2;

        LineEdit {
            horizontal-stretch: 1;
            text <=> Analysis.evidence-query;
            placeholder-text: root.findings ? "Search findings" : "Search syntax fields";
            accessible-label: self.placeholder-text;
            accessible-description: root.findings ? "Search rule IDs and messages." : "Search canonical syntax names.";
            edited(value) => {
                Analysis.evidence-search(value);
            }
        }

        if root.findings: LinkButton {
            text: Analysis.validation-running ? "Cancel" : "Validate";
            description: Analysis.validation-running ? "Stop stream validation." : "Run validation on this stream.";
            clicked => {
                if Analysis.validation-running {
                    Analysis.cancel-validation();
                } else {
                    Analysis.validate-stream();
                }
            }
        }
    }

    if root.findings: HorizontalLayout {
        spacing: Tokens.space-2;

        ComboBox {
            width: 108px;
            model: ["All levels", "Errors", "Warnings", "Info"];
            current-index <=> Analysis.severity-index;
            accessible-label: "Severity filter";
            selected => {
                Analysis.evidence-severity(self.current-index);
            }
        }

        ComboBox {
            width: 100px;
            model: Analysis.finding-layers;
            current-index <=> Analysis.finding-layer-index;
            accessible-label: "Finding layer filter";
            selected => {
                Analysis.evidence-layer(self.current-index);
            }
        }

        LineEdit {
            horizontal-stretch: 1;
            text <=> Analysis.evidence-rule-query;
            placeholder-text: "Filter by rule ID";
            accessible-label: self.placeholder-text;
            edited(value) => {
                Analysis.evidence-rule(value);
            }
        }
    }

    Text {
        text: root.findings ? Analysis.findings-status : Analysis.syntax-status;
        color: Tokens.text-secondary;
        font-size: Tokens.type-caption * 1rem;
        wrap: word-wrap;
        accessible-live-region: polite;
    }

    if Analysis.evidence-rows.length > 0: EvidenceList {
        copy(text) => {
            root.copy(text);
        }
    }

    if Analysis.evidence-page-label != "" || Analysis.evidence-can-prev || Analysis.evidence-can-next: HorizontalLayout {
        spacing: Tokens.space-2;

        LinkButton {
            text: "Previous Page";
            quiet: true;
            enabled: Analysis.evidence-can-prev;
            clicked => {
                Analysis.evidence-page(-1);
            }
        }

        Caption {
            text: Analysis.evidence-page-label;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }

        LinkButton {
            text: "Next Page";
            quiet: true;
            enabled: Analysis.evidence-can-next;
            clicked => {
                Analysis.evidence-page(1);
            }
        }
    }

    if root.findings || Analysis.evidence-copy != "": HorizontalLayout {
        spacing: Tokens.space-2;

        if root.findings: LinkButton {
            text: "Previous Finding";
            quiet: true;
            enabled: Analysis.finding-can-prev;
            clicked => {
                Analysis.finding-step(-1);
            }
        }

        if root.findings: LinkButton {
            text: "Next Finding";
            quiet: true;
            enabled: Analysis.finding-can-next;
            clicked => {
                Analysis.finding-step(1);
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if Analysis.evidence-copy != "": LinkButton {
            text: "Copy Evidence";
            quiet: true;
            description: "Copy the selected syntax observation or finding.";
            clicked => {
                root.copy(Analysis.evidence-copy);
            }
        }
    }

    if Analysis.evidence-detail != "" || Analysis.evidence-note != "": ScrollView {
        min-height: 64px;
        preferred-height: 80px;
        max-height: 104px;
        VerticalLayout {
            alignment: start;
            spacing: Tokens.space-1;
            Text {
                text: Analysis.evidence-detail;
                color: Tokens.text;
                font-size: Tokens.type-caption * 1rem;
                wrap: word-wrap;
            }

            if Analysis.evidence-note != "": Caption {
                text: Analysis.evidence-note;
                accessible-live-region: polite;
            }
        }
    }
}

// The byte window, one Tab stop. The arrows move the cursor, Page Up and
// Page Down a window, Home and End to the file's ends; Enter or Space
// selects the element at the cursor, as a click on a byte does.
component ByteView inherits KeyboardFocus {
    in property <length> cell-width: 20px;
    in property <length> line-height: 18px;

    // A read-only text field with a caret is the closest role that takes
    // keyboard focus; the value is the byte under the cursor, in words.
    accessible-role: text-input;
    accessible-read-only: true;
    accessible-label: "Bytes";
    accessible-value: Analysis.cursor-line;
    accessible-description: "Arrow keys move the cursor; Enter selects the element at the cursor.";
    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.keyboard-used();
            Analysis.select-at-cursor();
            return accept;
        }
        let step = Steps.of(event.text);
        if step == NavStep.none {
            return reject;
        }
        root.keyboard-used();
        Analysis.cursor(step);
        accept
    }

    FocusRing {
        shown: root.ring;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Tokens.radius-small;
    }

    VerticalLayout {
        for line[l] in Analysis.byte-lines: HorizontalLayout {
            height: root.line-height;
            spacing: Tokens.space-2;

            // As wide as the offset needs (16 hex digits at most), as in the
            // navigator.
            Text {
                width: max(64px, self.preferred-width);
                text: line.offset;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                font-family: "monospace";
                horizontal-alignment: right;
                vertical-alignment: center;
                accessible-role: none;
            }

            HorizontalLayout {
                for cell[c] in line.cells: Rectangle {
                    width: root.cell-width;
                    background: cell.evidence ? Tokens.row-selected : Analysis.tint(cell.region);
                    border-width: cell.cursor ? (root.has-focus ? 2px : 1px) : 0px;
                    border-color: root.has-focus ? Tokens.focus-ring : Tokens.text-secondary;
                    border-radius: 2px;

                    if cell.evidence: Rectangle {
                        y: parent.height - 2px;
                        width: parent.width;
                        height: 2px;
                        background: Tokens.accent;
                    }

                    Text {
                        text: cell.text;
                        color: Tokens.text;
                        font-size: Tokens.type-caption * 1rem;
                        font-family: "monospace";
                        // Bytes of the selection are bold, so they do not rest on the tint.
                        font-weight: cell.region != ByteRegion.outside ? Tokens.weight-bold : Tokens.weight-regular;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.focus();
                            Analysis.byte-clicked(l * 16 + c);
                        }
                    }
                }
            }

            Text {
                text: line.ascii;
                color: Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                font-family: "monospace";
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

// A quiet card for the empty, opening and failed states.
component StateCard inherits Rectangle {
    in property <string> heading;
    in property <string> text;
    in property <bool> problem;
    in property <string> action;
    in property <string> action-description;
    in property <string> second;
    callback act();
    callback second-act();

    border-radius: Tokens.radius-medium + 2px;
    background: Tokens.track;
    border-width: 1px;
    border-color: Tokens.border-strong;
    accessible-role: region;
    accessible-label: root.heading;

    VerticalLayout {
        alignment: center;
        spacing: Tokens.space-2;
        padding: Tokens.space-6;

        Text {
            text: root.heading;
            color: Tokens.text;
            font-size: Tokens.type-title * 1rem;
            font-weight: Tokens.weight-semibold;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.text;
            color: root.problem ? Tokens.error : Tokens.text-secondary;
            font-size: Tokens.type-caption * 1rem;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-live-region: polite;
        }

        HorizontalLayout {
            alignment: center;
            spacing: Tokens.space-3;
            padding-top: Tokens.space-1;

            if root.action != "": Button {
                text: root.action;
                accessible-description: root.action-description;
                clicked => {
                    root.act();
                }
            }

            if root.second != "": Button {
                text: root.second;
                clicked => {
                    root.second-act();
                }
            }
        }
    }
}

// The whole workspace.
export component AnalyzeView inherits VerticalLayout {
    in property <string> open-shortcut;
    property <length> navigator-width: 320px;
    property <length> detail-width: 380px;
    out property <length> full-width: root.navigator-width + Tokens.space-4 + root.detail-width;
    out property <length> playback-height: 240px;

    min-width: root.full-width;
    preferred-width: root.full-width;
    spacing: Tokens.space-2;
    accessible-role: main;
    accessible-label: "Analyze";

    // The window copies `text` to the clipboard.
    callback copy(string);
    callback reveal-bytes();

    // The documents and what reading the shown one found.
    if Analysis.documents.length > 0: HorizontalLayout {
        spacing: Tokens.space-2;

        ComboBox {
            width: root.navigator-width;
            model: Analysis.documents;
            current-index <=> Analysis.document-index;
            accessible-label: "Document";
            selected => {
                Analysis.show(self.current-index);
            }
        }

        Caption {
            horizontal-stretch: 1;
            text: Analysis.state == AnalysisState.open ? Analysis.summary-line : "";
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
        }

        LinkButton {
            text: "Open…";
            description: "Open an AV2 IVF or Annex B stream to analyze (" + root.open-shortcut + ")";
            clicked => {
                Analysis.open();
            }
        }

        LinkButton {
            text: "Close";
            description: "Close the shown document; the file is not touched";
            clicked => {
                Analysis.close();
            }
        }
    }

    if Analysis.notice != "": Text {
        text: Analysis.notice;
        color: Tokens.warning;
        font-size: Tokens.type-caption * 1rem;
        font-weight: Tokens.weight-semibold;
        wrap: word-wrap;
        accessible-live-region: polite;
    }

    if Analysis.state == AnalysisState.empty: StateCard {
        height: 220px;
        heading: "Open an AV2 stream to analyze it";
        text: Analysis.message;
        action: "Open…";
        action-description: "Choose an IVF or Annex B file (" + root.open-shortcut + ")";
        act => {
            Analysis.open();
        }
    }

    if Analysis.state == AnalysisState.opening: StateCard {
        height: 220px;
        heading: "Reading the stream…";
        text: Analysis.message;
        action: Analysis.can-cancel-read ? "Cancel" : "";
        action-description: "Stop reading this file";
        act => {
            Analysis.cancel();
        }
    }

    if Analysis.state == AnalysisState.failed: StateCard {
        height: 220px;
        heading: "This stream cannot be shown";
        text: Analysis.message;
        problem: true;
        action: "Reopen";
        action-description: "Read the file again";
        second: "Close";
        act => {
            Analysis.reopen();
        }
        second-act => {
            Analysis.close();
        }
    }

    if Analysis.state == AnalysisState.attention: StateCard {
        height: 220px;
        heading: Analysis.heading;
        text: Analysis.message;
        action: Analysis.action;
        action-description: Analysis.action-description;
        second: "Close";
        act => {
            Analysis.resolve();
        }
        second-act => {
            Analysis.close();
        }
    }

    if Analysis.state == AnalysisState.open: VerticalLayout {
        spacing: Tokens.space-2;

        HorizontalLayout {
            spacing: Tokens.space-2;

            Text {
                horizontal-stretch: 1;
                text: Analysis.outcome-line;
                color: Analysis.outcome-problem ? Tokens.warning : Tokens.text-secondary;
                font-size: Tokens.type-caption * 1rem;
                font-weight: Analysis.outcome-problem ? Tokens.weight-semibold : Tokens.weight-regular;
                wrap: word-wrap;
                // Read out when a document is shown, as where reading stopped
                // matters before anything in it is chosen.
                accessible-live-region: polite;
            }

            LinkButton {
                min-height: 0;
                text: Playback.state == StageState.none ? "Show Playback" : "Hide Playback";
                description: Analysis.can-playback ? "Show or hide AV2 playback." : "Read the file again to verify the source bytes for playback.";
                enabled: Analysis.can-playback;
                accessible-expandable: true;
                accessible-expanded: Playback.state != StageState.none;
                clicked => {
                    Analysis.toggle-playback();
                }
            }

            if Analysis.can-cancel-read: LinkButton {
                min-height: 0;
                text: "Cancel Scan";
                description: "Stop reading this file";
                clicked => {
                    Analysis.cancel();
                }
            }

            if Analysis.can-read-again: LinkButton {
                min-height: 0;
                text: "Read Again";
                description: "Read the whole file; the selection is kept";
                clicked => {
                    Analysis.reopen();
                }
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-3;
            alignment: start;

            LinkButton {
                min-height: 20px;
                text: "Export Decoded Video…";
                description: "Export native decoded samples from the open streams.";
                enabled: DecodeExport.can-start;
                clicked => { DecodeExport.open(ExportPurpose.video); }
            }

            LinkButton {
                min-height: 20px;
                text: "Export Frame…";
                description: "Export the displayed output picture. Pause playback to select a picture.";
                enabled: DecodeExport.can-frame;
                clicked => { DecodeExport.open(ExportPurpose.frame); }
            }

            LinkButton {
                min-height: 20px;
                text: "Frame Hashes…";
                description: "Export a SHA-256 report for decoded samples.";
                enabled: DecodeExport.can-start;
                clicked => { DecodeExport.open(ExportPurpose.hashes); }
            }
        }

        if Analysis.can-playback && Playback.state != StageState.none: VerticalLayout {
            spacing: Tokens.space-1;

            HorizontalLayout {
                spacing: Tokens.space-2;

                ComboBox {
                    width: 150px;
                    model: Playback.chroma ? ["RGB", "Y luma", "U chroma", "V chroma"] : ["RGB", "Y luma"];
                    current-index <=> Playback.surface;
                    accessible-label: "Picture surface";
                    selected => { Playback.choose-surface(self.current-index); }
                }

                ComboBox {
                    width: 110px;
                    model: ["Fit", "1:1", "2×", "4×", "8×", "16×"];
                    current-index <=> Playback.zoom;
                    accessible-label: "Picture zoom";
                    accessible-description: "Fit uses interpolation. Other levels use nearest-neighbor scaling.";
                    selected => { Playback.choose-zoom(self.current-index); }
                }

                ToggleChip {
                    text: "Film Grain";
                    label: "Apply film grain";
                    description: "Apply grain when the stream signals it. Clear this option to read samples before grain.";
                    checked: Playback.grain;
                    toggled => { Playback.toggle-grain(!Playback.grain); }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            PlaybackPanel {
                document: true;
                picture-height: root.playback-height;
            }

            if Playback.viewer-geometry != "": Caption {
                text: Playback.viewer-geometry;
                wrap: word-wrap;
            }

            if Playback.viewer-policy != "": Caption {
                text: Playback.viewer-policy;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Tokens.space-2;
                Caption {
                    text: Playback.sample-plane + " sample";
                    vertical-alignment: center;
                }

                Caption {
                    text: "X";
                    vertical-alignment: center;
                    accessible-role: none;
                }

                sample-x := LineEdit {
                    width: 72px;
                    property <string> selected-coordinate: Playback.sample-x;
                    text: self.selected-coordinate == "" ? "0" : self.selected-coordinate;
                    changed selected-coordinate => {
                        self.text = self.selected-coordinate == "" ? "0" : self.selected-coordinate;
                    }
                    enabled: Playback.can-sample;
                    accessible-label: Playback.sample-plane + " column X";
                    accessible-description: "Column in the visible plane. The first column is zero.";
                    accepted(text) => { Playback.read-sample(text, sample-y.text); }
                }

                Caption {
                    text: "Y";
                    vertical-alignment: center;
                    accessible-role: none;
                }

                sample-y := LineEdit {
                    width: 72px;
                    property <string> selected-coordinate: Playback.sample-y;
                    text: self.selected-coordinate == "" ? "0" : self.selected-coordinate;
                    changed selected-coordinate => {
                        self.text = self.selected-coordinate == "" ? "0" : self.selected-coordinate;
                    }
                    enabled: Playback.can-sample;
                    accessible-label: Playback.sample-plane + " row Y";
                    accessible-description: "Row in the visible plane. The first row is zero.";
                    accepted(text) => { Playback.read-sample(sample-x.text, text); }
                }

                LinkButton {
                    text: "Read Sample";
                    description: "Read the decoded sample at the entered coordinates.";
                    enabled: Playback.can-sample;
                    clicked => { Playback.read-sample(sample-x.text, sample-y.text); }
                }

                Caption {
                    horizontal-stretch: 1;
                    text: Playback.sample-text;
                    vertical-alignment: center;
                    accessible-live-region: polite;
                }

                if Playback.sample-copy != "": LinkButton {
                    text: "Copy Value";
                    description: "Copy the decoded sample value.";
                    clicked => { root.copy(Playback.sample-copy); }
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-2;

                LineEdit {
                    width: 150px;
                    placeholder-text: "Go to output…";
                    accessible-label: "Go to output number";
                    accessible-description: "Enter a positive output number.";
                    enabled: Playback.navigable;
                    accepted(text) => {
                        Playback.seek-output(text);
                    }
                }

                if Playback.decode-work != "": LinkButton {
                    text: "Cancel Decode";
                    description: "Stop reading or decoding this picture.";
                    clicked => {
                        Playback.cancel-decode();
                    }
                }

                Caption {
                    horizontal-stretch: 1;
                    text: Playback.state == StageState.loading ? "" : Playback.decode-work;
                    vertical-alignment: center;
                    accessible-live-region: polite;
                }
            }

            if Playback.seek-error != "": Caption {
                text: Playback.seek-error;
                color: Tokens.warning;
                accessible-live-region: polite;
            }

            if Playback.output-unit != "": HorizontalLayout {
                spacing: Tokens.space-2;

                Caption {
                    text: Playback.output-layers;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                for link[index] in [
                    { label: "Temporal Unit", value: Playback.output-unit },
                    { label: "Coded Frame", value: Playback.output-coded },
                    { label: "Showing Frame", value: Playback.output-showing },
                    { label: "Sequence Header", value: Playback.output-sequence }
                ]: LinkButton {
                    visible: link.value != "";
                    min-height: 20px;
                    quiet: true;
                    text: link.label;
                    description: "Show " + link.label + " at " + link.value;
                    clicked => {
                        Playback.show-bytes(index);
                        root.reveal-bytes();
                        if Analysis.bytes-shown {
                            byte-view.focus();
                        }
                    }
                }
            }
        }

        // History, filters and go to offset.
        HorizontalLayout {
            spacing: Tokens.space-2;

            IconButton {
                label: "Back";
                description: "The previous selection";
                enabled: Analysis.can-back;
                icon: "M 10.5 2.5 L 4.5 8 L 10.5 13.5 L 11.8 12.2 L 7.2 8 L 11.8 3.8 Z";
                clicked => {
                    Analysis.back();
                }
            }

            IconButton {
                label: "Forward";
                description: "The next selection";
                enabled: Analysis.can-forward;
                icon: "M 5.5 2.5 L 11.5 8 L 5.5 13.5 L 4.2 12.2 L 8.8 8 L 4.2 3.8 Z";
                clicked => {
                    Analysis.forward();
                }
            }

            ComboBox {
                width: 220px;
                model: Analysis.type-labels;
                current-index <=> Analysis.type-index;
                accessible-label: "Type filter";
                selected => {
                    Analysis.type-filter(self.current-index);
                }
            }

            ComboBox {
                width: 180px;
                model: Analysis.layer-labels;
                current-index <=> Analysis.layer-index;
                accessible-label: "Layer filter";
                selected => {
                    Analysis.layer-filter(self.current-index);
                }
            }

            if Analysis.filtered: LinkButton {
                text: "Clear";
                description: "Show every element again";
                clicked => {
                    Analysis.clear-filters();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            goto := LineEdit {
                width: 150px;
                placeholder-text: "Go to byte…";
                accessible-label: "Go to byte offset";
                accessible-description: "A decimal offset, or hexadecimal after 0x. Enter selects the element there.";
                accepted(text) => {
                    Analysis.go-to(text);
                }
            }
        }

        // The navigator and the selected element's properties side by
        // side; the bytes under both, so the view fits a window 800
        // pixels wide.
        HorizontalLayout {
            spacing: Tokens.space-4;
            alignment: start;

            VerticalLayout {
                width: root.navigator-width;
                alignment: start;
                spacing: Tokens.space-1;

                // The list's description says this already. `accessible-role:
                // none` hides only a plain `Text`: on an instance of a text
                // component (`SectionTitle`, `Caption`) Slint 1.19 keeps the
                // element and gives it an unknown role.
                Text {
                    text: Analysis.rows-line;
                    color: Tokens.text-secondary;
                    font-size: Tokens.type-caption * 1rem;
                    font-weight: Tokens.weight-semibold;
                    accessible-role: none;
                }

                if Analysis.hidden-note != "": Caption {
                    text: Analysis.hidden-note;
                    color: Tokens.text;
                    accessible-live-region: polite;
                }

                Navigator { }
            }

            VerticalLayout {
                width: root.detail-width;
                spacing: Tokens.space-1;

                if !Analysis.reading: WorkspaceSwitch {
                    options: ["Properties", "Syntax", "Findings"];
                    accessible-label: "Inspector views";
                    selected: Analysis.evidence-tab;
                    chosen(index) => {
                        Analysis.evidence-view(index);
                    }
                }

                if Analysis.evidence-tab == 0: VerticalLayout {
                    spacing: Tokens.space-1;

                    HorizontalLayout {
                        spacing: Tokens.space-2;

                        Text {
                            horizontal-stretch: 1;
                            text: Analysis.inspector-title;
                            color: Tokens.text;
                            font-size: Tokens.type-body * 1rem;
                            font-weight: Tokens.weight-semibold;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        LinkButton {
                            min-height: 20px;
                            text: "Copy Value";
                            quiet: true;
                            description: "Copy the chosen property's value";
                            enabled: Analysis.properties.length > 0;
                            clicked => {
                                root.copy(Analysis.properties[min(inspector.current, Analysis.properties.length - 1)].value);
                            }
                        }

                        LinkButton {
                            min-height: 20px;
                            text: "Copy Row";
                            quiet: true;
                            description: "Copy the selected element's row";
                            enabled: Analysis.selected-line != "";
                            clicked => {
                                root.copy(Analysis.selected-line);
                            }
                        }

                        LinkButton {
                            min-height: 20px;
                            text: "Copy Offset";
                            quiet: true;
                            description: "Copy the selected element's first byte offset";
                            enabled: Analysis.selected-offset != "";
                            clicked => {
                                root.copy(Analysis.selected-offset);
                            }
                        }
                    }

                    inspector := Inspector {
                        vertical-stretch: 1;
                        min-height: 96px;
                        copy(text) => {
                            root.copy(text);
                        }
                    }
                }

                if Analysis.evidence-tab != 0: EvidencePane {
                    copy(text) => {
                        root.copy(text);
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Analysis.bytes-shown ? Tokens.space-1 : 0px;

            HorizontalLayout {
                spacing: Tokens.space-2;

                LinkButton {
                    min-height: 20px;
                    text: Analysis.bytes-shown ? "Hide Bytes" : "Show Bytes";
                    quiet: true;
                    description: "The file's bytes around the selection";
                    accessible-expandable: true;
                    accessible-expanded: Analysis.bytes-shown;
                    clicked => {
                        Analysis.toggle-bytes();
                    }
                }

                Caption {
                    horizontal-stretch: 1;
                    text: Analysis.bytes-title;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: Tokens.space-4;
                alignment: start;
                visible: Analysis.bytes-shown;
                min-height: Analysis.bytes-shown ? self.preferred-height : 0px;
                max-height: self.min-height;

                byte-view := ByteView {
                    enabled: Analysis.bytes-shown;
                }

                // Which part each tint is, and the byte under the cursor in
                // words: the parts do not rest on the tints alone.
                VerticalLayout {
                    spacing: Tokens.space-1;
                    alignment: start;

                    for item in Analysis.legend: HorizontalLayout {
                        spacing: Tokens.space-1;

                        Rectangle {
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 2px;
                            background: Analysis.tint(item.region);
                            border-width: 1px;
                            border-color: Tokens.border;
                        }

                        Caption {
                            text: item.label;
                            wrap: no-wrap;
                        }
                    }

                    // The byte view's value says this already (see the
                    // element count above for why a plain `Text`).
                    Text {
                        text: Analysis.cursor-line;
                        color: Tokens.text;
                        font-size: Tokens.type-caption * 1rem;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                }
            }
        }
    }
}
